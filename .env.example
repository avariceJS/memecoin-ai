# Used only by explicitly invoked read-only RPC commands. Never commit the real .env.
MEMECOIN_RPC_URL=https://api.mainnet-beta.solana.com
# Set locally for crosscheck-captures; choose an accessible independent operator.
# No automatic fallback to the primary provider.
MEMECOIN_SECONDARY_RPC_URL=
# Current candidate: Helius. Configure locally; CLI never loads dotenv automatically.
# Dedicated variable avoids accidentally reusing the former provider URL.
MEMECOIN_HELIUS_RPC_URL=
# D40 pilot only. tools/alchemy_pilot.py explicitly parses these local settings.
MEMECOIN_ALCHEMY_HTTP_URL=
MEMECOIN_ALCHEMY_WSS_URL=
# Separate Free-plan Solana mainnet endpoint for bounded development checks.
MEMECOIN_ALCHEMY_FREE_HTTP_URL=
