+        let fee_schedule = schedule(0, 9, 333);
+        let mut prior_fee = 0;
+        for gross in 1..=512 {
+            let fee = calculate_fee(&fee_schedule, gross).unwrap();
+            assert!(fee >= prior_fee, "fee decreased at gross={gross}");
+            assert!(fee <= fee_schedule.maximum_fee);
+            let reference_ceil = ((gross as u128 * 333) + 9_999) / 10_000;
+            let reference = u64::try_from(reference_ceil)
+                .unwrap()
+                .min(fee_schedule.maximum_fee);
+            assert_eq!(fee, reference, "fee oracle mismatch at gross={gross}");
+            prior_fee = fee;
+        }
+    }
