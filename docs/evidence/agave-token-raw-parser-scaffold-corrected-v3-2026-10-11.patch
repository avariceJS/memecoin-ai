+        let mut execute = TRANSFER_HOOK_EXECUTE_DISCRIMINATOR.to_vec();
+        execute.extend_from_slice(&99u64.to_le_bytes());
+        assert_eq!(decode_transfer_hook_execute(&execute), Ok(99));
+        execute[0] ^= 1;
+        assert_eq!(
+            decode_transfer_hook_execute(&execute),
+            Err(DecodeClass::Malformed("transfer_hook_execute_encoding"))
+        );
