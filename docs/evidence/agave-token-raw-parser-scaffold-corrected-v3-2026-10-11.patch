--- /dev/null
+++ b/program-test/src/candidate_position_witness_mapping.rs
@@ -0,0 +1,973 @@
+//! Pure mapping helpers for fabricated raw-account witness vectors.
+//!
+//! This module consumes unsigned fixture keys, instruction bytes, source-pinned
+//! account layouts, and explicitly supplied epoch/Rent values. It is not wired
+//! to ProgramTest transactions, observer traces, or settlement decisions.
+//!
+//! Deterministic mapping contract for a future trace adapter: bind each role to
+//! its signed-message account index and pubkey; for each requested phase, select
+//! the unique available v5 event account whose transaction index and pubkey
+//! match that role; copy owner/data/lamports without unit conversion; derive
+//! instruction account indices from the frame's ordered indices. Missing,
+//! duplicate, unavailable, or mismatched observations map to `DecodeClass`
+//! failure. This DTO contract does not claim the raw parser and trace schemas
+//! have been integrated or qualified together.
+
+use crate::candidate_position_raw_account::{
+    calculate_fee, decode_mint, decode_supported_instruction, decode_token_account,
+    expected_close_lamports, expected_sync_native_amount, schedule_for_epoch,
+    validate_native_account_roles, validate_transfer_roles, DecodeClass, NativeTransition,
+    RawTokenAccount, SupportedInstruction, LEGACY_NATIVE_MINT_ID, LEGACY_TOKEN_PROGRAM_ID,
+    TOKEN_2022_PROGRAM_ID,
+};
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RawAccountSnapshot {
+    pub key: [u8; 32],
+    pub owner: Option<[u8; 32]>,
+    pub data: Option<Vec<u8>>,
+    pub lamports: Option<u64>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct TransferRoleIndices {
+    pub source: u16,
+    pub mint: u16,
+    pub destination: u16,
+    pub authority: u16,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TransferPhase {
+    Before,
+    After,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct Token2022TransferInput {
+    pub token_2022_program: [u8; 32],
+    pub message_account_keys: Vec<[u8; 32]>,
+    pub instruction_account_indices: Vec<u16>,
+    pub roles: TransferRoleIndices,
+    pub instruction_data: Vec<u8>,
+    pub epoch: u64,
+    pub source_authority: [u8; 32],
+    pub destination_authority: [u8; 32],
+    pub phase_order: Vec<TransferPhase>,
+    pub mint: Option<RawAccountSnapshot>,
+    pub source_before: Option<RawAccountSnapshot>,
+    pub source_after: Option<RawAccountSnapshot>,
+    pub destination_before: Option<RawAccountSnapshot>,
+    pub destination_after: Option<RawAccountSnapshot>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct Token2022TransferArithmetic {
+    pub epoch: u64,
+    pub fee_schedule_epoch: Option<u64>,
+    pub decimals: u8,
+    pub gross_atomic_units: u64,
+    pub fee_atomic_units: u64,
+    pub net_atomic_units: u64,
+    pub source_debit_atomic_units: u64,
+    pub destination_credit_atomic_units: u64,
+    pub withheld_delta_atomic_units: u64,
+}
+
+fn expected_message_key(
+    keys: &[[u8; 32]],
+    index: u16,
+    expected: &[u8; 32],
+) -> Result<(), DecodeClass> {
+    let key = keys
+        .get(index as usize)
+        .ok_or(DecodeClass::Missing("message_account_index"))?;
+    if key != expected {
+        return Err(DecodeClass::Malformed("message_account_role_mismatch"));
+    }
+    Ok(())
+}
+
+fn checked_snapshot<'a>(
+    snapshot: &'a Option<RawAccountSnapshot>,
+    expected_key: &[u8; 32],
+    expected_owner: &[u8; 32],
+    role: &'static str,
+) -> Result<(&'a RawAccountSnapshot, &'a [u8]), DecodeClass> {
+    let snapshot = snapshot.as_ref().ok_or(DecodeClass::Missing(role))?;
+    if &snapshot.key != expected_key {
+        return Err(DecodeClass::Malformed("snapshot_pubkey_role_mismatch"));
+    }
+    if snapshot.owner.as_ref() != Some(expected_owner) {
+        return Err(DecodeClass::Malformed("snapshot_owner_program_mismatch"));
+    }
+    let data = snapshot.data.as_deref().ok_or(DecodeClass::Missing(role))?;
+    Ok((snapshot, data))
+}
+
+/// Derive fee and token-unit conservation facts from unsigned snapshots.
+///
+/// A successful return means only that the supplied raw bytes and declared
+/// roles are arithmetically consistent. It does not prove that a transaction
+/// executed, committed, or settled.
+pub fn derive_token_2022_transfer_arithmetic(
+    input: &Token2022TransferInput,
+) -> Result<Token2022TransferArithmetic, DecodeClass> {
+    if input.token_2022_program != TOKEN_2022_PROGRAM_ID {
+        return Err(DecodeClass::Malformed("token_2022_program_id_mismatch"));
+    }
+    if input.phase_order != [TransferPhase::Before, TransferPhase::After] {
+        return Err(DecodeClass::Malformed("transfer_phase_order"));
+    }
+    let roles = input.roles;
+    if roles.source == roles.mint
+        || roles.source == roles.destination
+        || roles.mint == roles.destination
+    {
+        return Err(DecodeClass::Malformed("source_mint_destination_alias"));
+    }
+    if input.instruction_account_indices
+        != [roles.source, roles.mint, roles.destination, roles.authority]
+    {
+        return Err(DecodeClass::Malformed("instruction_role_index_order"));
+    }
+    let source_key = *input
+        .message_account_keys
+        .get(roles.source as usize)
+        .ok_or(DecodeClass::Missing("source_message_key"))?;
+    let mint_key = *input
+        .message_account_keys
+        .get(roles.mint as usize)
+        .ok_or(DecodeClass::Missing("mint_message_key"))?;
+    let destination_key = *input
+        .message_account_keys
+        .get(roles.destination as usize)
+        .ok_or(DecodeClass::Missing("destination_message_key"))?;
+    let authority_key = *input
+        .message_account_keys
+        .get(roles.authority as usize)
+        .ok_or(DecodeClass::Missing("authority_message_key"))?;
+    if source_key == destination_key || source_key == mint_key || destination_key == mint_key {
+        return Err(DecodeClass::Malformed("source_mint_destination_alias"));
+    }
+
+    let (mint_snapshot, mint_data) = checked_snapshot(
+        &input.mint,
+        &mint_key,
+        &TOKEN_2022_PROGRAM_ID,
+        "mint_snapshot",
+    )?;
+    let _ = mint_snapshot;
+    let mint = decode_mint(mint_data)?;
+    if mint.transfer_hook_program.is_some() {
+        return Err(DecodeClass::Unsupported(
+            "active_transfer_hook_runtime_semantics_unqualified",
+        ));
+    }
+    let instruction = decode_supported_instruction(true, &input.instruction_data)?;
+    let (gross, instruction_decimals) = match instruction {
+        SupportedInstruction::TransferChecked {
+            gross_atomic_units,
+            decimals,
+        } => (gross_atomic_units, decimals),
+        _ => return Err(DecodeClass::Unsupported("not_transfer_checked")),
+    };
+    let (fee_schedule_epoch, fee) = match mint.transfer_fee.as_ref() {
+        Some(fee_config) => {
+            let fee_schedule = schedule_for_epoch(fee_config, input.epoch);
+            (
+                Some(fee_schedule.epoch),
+                calculate_fee(fee_schedule, gross)?,
+            )
+        }
+        None => (None, 0),
+    };
+
+    let (source_before_snapshot, source_before_data) = checked_snapshot(
+        &input.source_before,
+        &source_key,
+        &TOKEN_2022_PROGRAM_ID,
+        "source_before_snapshot",
+    )?;
+    let (source_after_snapshot, source_after_data) = checked_snapshot(
+        &input.source_after,
+        &source_key,
+        &TOKEN_2022_PROGRAM_ID,
+        "source_after_snapshot",
+    )?;
+    let (destination_before_snapshot, destination_before_data) = checked_snapshot(
+        &input.destination_before,
+        &destination_key,
+        &TOKEN_2022_PROGRAM_ID,
+        "destination_before_snapshot",
+    )?;
+    let (destination_after_snapshot, destination_after_data) = checked_snapshot(
+        &input.destination_after,
+        &destination_key,
+        &TOKEN_2022_PROGRAM_ID,
+        "destination_after_snapshot",
+    )?;
+
+    let source_before = decode_token_account(source_before_data, true)?;
+    let source_after = decode_token_account(source_after_data, true)?;
+    let destination_before = decode_token_account(destination_before_data, true)?;
+    let destination_after = decode_token_account(destination_after_data, true)?;
+    for (source, destination) in [
+        (&source_before, &destination_before),
+        (&source_after, &destination_after),
+    ] {
+        validate_transfer_roles(
+            &mint,
+            source,
+            destination,
+            &mint_key,
+            &input.source_authority,
+            &input.destination_authority,
+            instruction_decimals,
+        )?;
+    }
+    expected_message_key(&input.message_account_keys, roles.authority, &authority_key)?;
+    if authority_key != input.source_authority {
+        return Err(DecodeClass::Malformed("transfer_authority_role_mismatch"));
+    }
+    let source_debit = source_before
+        .amount
+        .checked_sub(source_after.amount)
+        .ok_or(DecodeClass::Malformed("source_amount_increased"))?;
+    let destination_credit = destination_after
+        .amount
+        .checked_sub(destination_before.amount)
+        .ok_or(DecodeClass::Malformed("destination_amount_decreased"))?;
+    let (withheld_before, withheld_after) = match (
+        fee_schedule_epoch,
+        destination_before.withheld_amount,
+        destination_after.withheld_amount,
+    ) {
+        (Some(_), Some(before), Some(after)) => (before, after),
+        (Some(_), _, _) => return Err(DecodeClass::Missing("destination_withheld_amount")),
+        (None, None, None) => (0, 0),
+        (None, _, _) => {
+            return Err(DecodeClass::Malformed(
+                "unexpected_withheld_amount_without_fee_config",
+            ))
+        }
+    };
+    let withheld_delta = withheld_after
+        .checked_sub(withheld_before)
+        .ok_or(DecodeClass::Malformed("withheld_amount_decreased"))?;
+    if source_debit != gross || destination_credit != gross - fee || withheld_delta != fee {
+        return Err(DecodeClass::Malformed(
+            "gross_net_fee_conservation_mismatch",
+        ));
+    }
+    for snapshot in [
+        source_before_snapshot,
+        source_after_snapshot,
+        destination_before_snapshot,
+        destination_after_snapshot,
+    ] {
+        if snapshot.lamports.is_none() {
+            return Err(DecodeClass::Missing("token_account_lamports"));
+        }
+    }
+    Ok(Token2022TransferArithmetic {
+        epoch: input.epoch,
+        fee_schedule_epoch,
+        decimals: instruction_decimals,
+        gross_atomic_units: gross,
+        fee_atomic_units: fee,
+        net_atomic_units: gross - fee,
+        source_debit_atomic_units: source_debit,
+        destination_credit_atomic_units: destination_credit,
+        withheld_delta_atomic_units: withheld_delta,
+    })
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NativePhase {
+    BeforeSync,
+    AfterSync,
+    BeforeClose,
+    AfterClose,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NativeAccountInput {
+    pub legacy_token_program: [u8; 32],
+    pub message_account_keys: Vec<[u8; 32]>,
+    pub native_mint: [u8; 32],
+    pub account_key_index: u16,
+    pub close_destination_key_index: u16,
+    pub authority_key_index: u16,
+    pub sync_instruction_account_indices: Vec<u16>,
+    pub close_instruction_account_indices: Vec<u16>,
+    pub sync_instruction_data: Vec<u8>,
+    pub close_instruction_data: Vec<u8>,
+    pub rent_reserve_lamports: u64,
+    pub phase_order: Vec<NativePhase>,
+    pub before_sync: Option<RawAccountSnapshot>,
+    pub after_sync: Option<RawAccountSnapshot>,
+    pub before_close: Option<RawAccountSnapshot>,
+    pub after_close: Option<RawAccountSnapshot>,
+    pub close_destination_before: Option<RawAccountSnapshot>,
+    pub close_destination_after: Option<RawAccountSnapshot>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NativeAccountArithmetic {
+    pub sync: NativeTransition,
+    pub amount_before_close_atomic_units: u64,
+    pub close_lamports_transferred: u64,
+    pub close_destination_lamport_delta: u64,
+}
+
+fn native_snapshot(
+    snapshot: &Option<RawAccountSnapshot>,
+    expected_key: &[u8; 32],
+    token_program: &[u8; 32],
+    role: &'static str,
+) -> Result<(RawTokenAccount, u64), DecodeClass> {
+    let (snapshot, data) = checked_snapshot(snapshot, expected_key, token_program, role)?;
+    let lamports = snapshot.lamports.ok_or(DecodeClass::Missing(role))?;
+    Ok((decode_token_account(data, false)?, lamports))
+}
