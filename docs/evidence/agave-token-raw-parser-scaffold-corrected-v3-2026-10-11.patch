+
+    #[test]
+    fn native_sync_and_close_keep_lamports_and_token_units_distinct() {
+        let sync = expected_sync_native_amount(10_000, 2_039, 5_000).unwrap();
+        assert_eq!(sync.amount_after_atomic_units, 7_961);
+        assert_eq!(sync.account_lamports, 10_000);
+        assert_eq!(sync.rent_reserve_lamports, 2_039);
