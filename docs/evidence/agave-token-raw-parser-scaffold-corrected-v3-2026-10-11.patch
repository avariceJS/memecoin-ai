+    fn append_tlv(out: &mut Vec<u8>, kind: u16, value: &[u8]) {
+        out.extend_from_slice(&kind.to_le_bytes());
+        out.extend_from_slice(&(value.len() as u16).to_le_bytes());
+        out.extend_from_slice(value);
+    }
+
+    fn fee_mint(older: FeeSchedule, newer: FeeSchedule, decimals: u8) -> Vec<u8> {
+        let mut mint = vec![0; 166];
+        mint[44] = decimals;
+        mint[45] = 1;
+        mint[165] = 1;
+        let mut config = vec![0; 108];
+        for (offset, schedule) in [(72, older), (90, newer)] {
+            config[offset..offset + 8].copy_from_slice(&schedule.epoch.to_le_bytes());
+            config[offset + 8..offset + 16].copy_from_slice(&schedule.maximum_fee.to_le_bytes());
+            config[offset + 16..offset + 18].copy_from_slice(&schedule.basis_points.to_le_bytes());
+        }
+        append_tlv(&mut mint, 1, &config);
+        mint
+    }
+
+    fn token_2022_account(
+        mint: [u8; 32],
+        authority: [u8; 32],
+        amount: u64,
+        withheld: u64,
+    ) -> Vec<u8> {
+        let mut account = vec![0; 166];
+        account[..32].copy_from_slice(&mint);
+        account[32..64].copy_from_slice(&authority);
+        account[64..72].copy_from_slice(&amount.to_le_bytes());
+        account[108] = 1;
+        account[165] = 2;
+        append_tlv(&mut account, 2, &withheld.to_le_bytes());
+        account
+    }
+
+    fn token_2022_account_without_fee_extension(
+        mint: [u8; 32],
+        authority: [u8; 32],
+        amount: u64,
+    ) -> Vec<u8> {
+        let mut account = token_2022_account(mint, authority, amount, 0);
+        account.truncate(165);
+        account
+    }
