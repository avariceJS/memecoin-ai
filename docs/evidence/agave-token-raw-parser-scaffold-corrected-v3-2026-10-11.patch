+/// Map fabricated SyncNative/CloseAccount phases into distinct lamport and
+/// token-unit arithmetic. The close helper is intentionally legacy WSOL only.
+pub fn derive_legacy_wsol_arithmetic(
+    input: &NativeAccountInput,
+) -> Result<NativeAccountArithmetic, DecodeClass> {
+    if input.legacy_token_program != LEGACY_TOKEN_PROGRAM_ID {
+        return Err(DecodeClass::Malformed("legacy_token_program_id_mismatch"));
+    }
+    if input.native_mint != LEGACY_NATIVE_MINT_ID {
+        return Err(DecodeClass::Malformed("legacy_native_mint_id_mismatch"));
+    }
+    if input.phase_order
+        != [
+            NativePhase::BeforeSync,
+            NativePhase::AfterSync,
+            NativePhase::BeforeClose,
+            NativePhase::AfterClose,
+        ]
+    {
+        return Err(DecodeClass::Malformed("native_phase_order"));
+    }
+    if input.sync_instruction_data != [17] || input.close_instruction_data != [9] {
+        return Err(DecodeClass::Malformed("native_instruction_data"));
+    }
+    if input.sync_instruction_account_indices != [input.account_key_index]
+        || input.close_instruction_account_indices
+            != [
+                input.account_key_index,
+                input.close_destination_key_index,
+                input.authority_key_index,
+            ]
+    {
+        return Err(DecodeClass::Malformed(
+            "native_instruction_role_index_order",
+        ));
+    }
+    let account_key = *input
+        .message_account_keys
+        .get(input.account_key_index as usize)
+        .ok_or(DecodeClass::Missing("native_message_account_key"))?;
+    let destination_key = *input
+        .message_account_keys
+        .get(input.close_destination_key_index as usize)
+        .ok_or(DecodeClass::Missing("close_destination_message_key"))?;
+    let authority_key = *input
+        .message_account_keys
+        .get(input.authority_key_index as usize)
+        .ok_or(DecodeClass::Missing("native_authority_message_key"))?;
+    if account_key == destination_key
+        || account_key == authority_key
+        || destination_key == authority_key
+    {
+        return Err(DecodeClass::Malformed("native_account_role_alias"));
+    }
+    let (before, before_lamports) = native_snapshot(
+        &input.before_sync,
+        &account_key,
+        &LEGACY_TOKEN_PROGRAM_ID,
+        "native_before_sync",
+    )?;
+    let (after_sync, after_sync_lamports) = native_snapshot(
+        &input.after_sync,
+        &account_key,
+        &LEGACY_TOKEN_PROGRAM_ID,
+        "native_after_sync",
+    )?;
+    let (before_close, before_close_lamports) = native_snapshot(
+        &input.before_close,
+        &account_key,
+        &LEGACY_TOKEN_PROGRAM_ID,
+        "native_before_close",
+    )?;
+    validate_native_account_roles(
+        &before,
+        &input.native_mint,
+        &authority_key,
+        input.rent_reserve_lamports,
+    )?;
+    validate_native_account_roles(
+        &after_sync,
+        &input.native_mint,
+        &authority_key,
+        input.rent_reserve_lamports,
+    )?;
+    validate_native_account_roles(
+        &before_close,
+        &input.native_mint,
+        &authority_key,
+        input.rent_reserve_lamports,
+    )?;
+    let sync =
+        expected_sync_native_amount(before_lamports, input.rent_reserve_lamports, before.amount)?;
+    if after_sync_lamports != before_lamports
+        || after_sync.amount != sync.amount_after_atomic_units
+        || before_close.amount != after_sync.amount
+        || before_close_lamports != after_sync_lamports
+    {
+        return Err(DecodeClass::Malformed("native_sync_close_state_mismatch"));
+    }
+    let (destination_before, destination_before_lamports) = input
+        .close_destination_before
+        .as_ref()
+        .ok_or(DecodeClass::Missing("close_destination_before"))
+        .and_then(|snapshot| {
+            if snapshot.key != destination_key {
+                return Err(DecodeClass::Malformed("close_destination_role_mismatch"));
+            }
+            Ok((
+                snapshot,
+                snapshot
+                    .lamports
+                    .ok_or(DecodeClass::Missing("close_destination_lamports"))?,
+            ))
+        })?;
+    let (destination_after, destination_after_lamports) = input
+        .close_destination_after
+        .as_ref()
+        .ok_or(DecodeClass::Missing("close_destination_after"))
+        .and_then(|snapshot| {
+            if snapshot.key != destination_key {
+                return Err(DecodeClass::Malformed("close_destination_role_mismatch"));
+            }
+            Ok((
+                snapshot,
+                snapshot
+                    .lamports
+                    .ok_or(DecodeClass::Missing("close_destination_lamports"))?,
+            ))
+        })?;
+    let _ = (destination_before, destination_after);
+    let after_close = input
+        .after_close
+        .as_ref()
+        .ok_or(DecodeClass::Missing("native_after_close"))?;
+    if after_close.key != account_key || after_close.lamports != Some(0) {
+        return Err(DecodeClass::Malformed("native_close_account_state"));
+    }
+    let close_lamports_transferred =
+        expected_close_lamports(true, before_close.amount, before_close_lamports)?;
+    let close_destination_lamport_delta = destination_after_lamports
+        .checked_sub(destination_before_lamports)
+        .ok_or(DecodeClass::Malformed(
+            "close_destination_lamports_decreased",
+        ))?;
+    if close_destination_lamport_delta != close_lamports_transferred {
+        return Err(DecodeClass::Malformed(
+            "native_close_lamport_conservation_mismatch",
+        ));
+    }
+    Ok(NativeAccountArithmetic {
+        sync,
+        amount_before_close_atomic_units: before_close.amount,
+        close_lamports_transferred,
+        close_destination_lamport_delta,
+    })
+}
