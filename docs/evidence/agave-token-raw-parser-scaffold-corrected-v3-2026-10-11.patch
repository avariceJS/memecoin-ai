+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn tlv(kind: u16, value: &[u8]) -> Vec<u8> {
+        let mut bytes = Vec::new();
+        bytes.extend_from_slice(&kind.to_le_bytes());
+        bytes.extend_from_slice(&(value.len() as u16).to_le_bytes());
+        bytes.extend_from_slice(value);
+        bytes
+    }
+
+    fn fee_config(older: FeeSchedule, newer: FeeSchedule) -> Vec<u8> {
+        let mut value = vec![0; TRANSFER_FEE_CONFIG_LEN];
+        for (offset, schedule) in [(72, older), (90, newer)] {
+            value[offset..offset + 8].copy_from_slice(&schedule.epoch.to_le_bytes());
+            value[offset + 8..offset + 16].copy_from_slice(&schedule.maximum_fee.to_le_bytes());
+            value[offset + 16..offset + 18].copy_from_slice(&schedule.basis_points.to_le_bytes());
+        }
+        value
+    }
+
+    #[test]
+    fn fee_rounding_cap_epoch_and_u64_edges() {
+        let older = FeeSchedule {
+            epoch: 0,
+            maximum_fee: 7,
+            basis_points: 250,
+        };
+        let newer = FeeSchedule {
+            epoch: 9,
+            maximum_fee: 3,
+            basis_points: 10_000,
+        };
+        let config = RawTransferFeeConfig { older, newer };
+        assert_eq!(schedule_for_epoch(&config, 8).basis_points, 250);
+        assert_eq!(schedule_for_epoch(&config, 9).basis_points, 10_000);
+        assert_eq!(calculate_fee(schedule_for_epoch(&config, 8), 1).unwrap(), 1);
+        assert_eq!(
+            calculate_fee(schedule_for_epoch(&config, 8), 1_000).unwrap(),
+            7
+        );
+        assert_eq!(
+            calculate_fee(schedule_for_epoch(&config, 9), u64::MAX).unwrap(),
+            3
+        );
+        assert_eq!(
+            calculate_fee(
+                &FeeSchedule {
+                    epoch: 0,
+                    maximum_fee: u64::MAX,
+                    basis_points: 0
+                },
+                u64::MAX
+            )
+            .unwrap(),
+            0
+        );
+    }
+
+    #[test]
+    fn fee_matches_reference_and_is_monotonic_across_atomic_inputs() {
+        let gross_values = (0..=256u64).chain([u64::MAX / 2, u64::MAX]);
+        let caps = [0, 1, 7, 255, u64::MAX];
+        for maximum_fee in caps {
+            let mut previous_fees_by_basis_points = vec![0; 10_001];
+            for gross in gross_values.clone() {
+                let mut previous_fee_for_gross = 0;
+                for basis_points in 0..=10_000u16 {
+                    let schedule = FeeSchedule {
+                        epoch: 0,
+                        maximum_fee,
+                        basis_points,
+                    };
+                    let fee = calculate_fee(&schedule, gross).unwrap();
+                    // Independent quotient/remainder oracle for round-up division.
+                    let numerator = gross as u128 * basis_points as u128;
+                    let quotient = numerator / 10_000;
+                    let remainder = numerator % 10_000;
+                    let reference_ceil = quotient + u128::from(remainder != 0);
+                    let reference_fee = u64::try_from(reference_ceil).unwrap().min(maximum_fee);
+                    assert_eq!(fee, reference_fee);
+                    assert!(
+                        fee >= previous_fee_for_gross,
+                        "fee decreased with basis points"
+                    );
+                    assert!(
+                        fee >= previous_fees_by_basis_points[basis_points as usize],
+                        "fee decreased with gross"
+                    );
+                    assert!(fee <= maximum_fee);
+                    assert!(fee <= gross);
+                    assert!(gross.checked_sub(fee).is_some());
+                    previous_fee_for_gross = fee;
+                    previous_fees_by_basis_points[basis_points as usize] = fee;
+                }
+            }
+        }
+    }
+
+    fn account_bytes(mint: [u8; 32], authority: [u8; 32], state: u8) -> Vec<u8> {
+        let mut bytes = vec![0; TOKEN_ACCOUNT_BASE_LEN];
+        bytes[..32].copy_from_slice(&mint);
+        bytes[32..64].copy_from_slice(&authority);
+        bytes[108] = state;
+        bytes
+    }
+
+    #[test]
+    fn token_base_fields_initialized_state_and_transfer_roles_are_bound() {
+        let mint_key = [1; 32];
+        let source_authority = [2; 32];
+        let destination_authority = [3; 32];
+        let mut mint_data = vec![0; MINT_BASE_LEN];
+        mint_data[44] = 6;
+        mint_data[45] = 1;
+        let mint = decode_mint(&mint_data).unwrap();
+        let source =
+            decode_token_account(&account_bytes(mint_key, source_authority, 1), false).unwrap();
+        let destination =
+            decode_token_account(&account_bytes(mint_key, destination_authority, 1), false)
+                .unwrap();
+        assert_eq!(source.mint_pubkey, mint_key);
+        assert_eq!(source.authority_pubkey, source_authority);
+        assert_eq!(source.state, TokenAccountState::Initialized);
+        assert_eq!(
+            validate_transfer_roles(
+                &mint,
+                &source,
+                &destination,
