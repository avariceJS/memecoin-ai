+//! Independent, bounded raw Token-2022/legacy token account decoder used only
+//! by the local ProgramTest witness fixtures.  This deliberately accepts a
+//! small declared subset and classifies all other layouts as unsupported. Its
+//! raw-account schema is separate from the synthetic candidate-position trace
+//! schema; no integrated qualification is claimed here.
+
+use std::collections::BTreeMap;
+
+const TOKEN_ACCOUNT_BASE_LEN: usize = 165;
+const MINT_BASE_LEN: usize = 82;
+const ACCOUNT_TYPE_OFFSET: usize = TOKEN_ACCOUNT_BASE_LEN;
+const ACCOUNT_TYPE_MINT: u8 = 1;
+const ACCOUNT_TYPE_ACCOUNT: u8 = 2;
+const EXT_TRANSFER_FEE_CONFIG: u16 = 1;
+const EXT_TRANSFER_FEE_AMOUNT: u16 = 2;
+const EXT_TRANSFER_HOOK: u16 = 14;
+const EXT_TRANSFER_HOOK_ACCOUNT: u16 = 15;
+const TRANSFER_FEE_CONFIG_LEN: usize = 108;
+const TRANSFER_HOOK_EXECUTE_DISCRIMINATOR: [u8; 8] =
+    [0x69, 0x25, 0x65, 0xc5, 0x4b, 0xfb, 0x66, 0x1a];
+
+/// Program and mint identities declared by the source-pinned upstream crates.
+pub const LEGACY_TOKEN_PROGRAM_ID: [u8; 32] =
+    solana_pubkey::pubkey!("TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA").to_bytes();
+pub const TOKEN_2022_PROGRAM_ID: [u8; 32] =
+    solana_pubkey::pubkey!("TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb").to_bytes();
+pub const LEGACY_NATIVE_MINT_ID: [u8; 32] =
+    solana_pubkey::pubkey!("So11111111111111111111111111111111111111112").to_bytes();
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum DecodeClass {
+    Supported,
+    Malformed(&'static str),
+    Missing(&'static str),
+    Unsupported(&'static str),
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RawTokenAccount {
+    pub mint_pubkey: [u8; 32],
+    pub authority_pubkey: [u8; 32],
+    pub state: TokenAccountState,
+    pub amount: u64,
+    pub native_reserve: Option<u64>,
+    pub withheld_amount: Option<u64>,
+    pub transfer_hook_account: Option<bool>,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TokenAccountState {
+    Uninitialized,
+    Initialized,
+    Frozen,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RawTransferFeeConfig {
+    pub older: FeeSchedule,
+    pub newer: FeeSchedule,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct FeeSchedule {
+    pub epoch: u64,
+    /// Transfer-fee cap in atomic token units.
+    pub maximum_fee: u64,
+    /// Dimensionless basis points, in the inclusive range 0..=10_000.
+    pub basis_points: u16,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct RawMint {
+    /// Decimal display metadata; stored amounts remain atomic token units.
+    pub decimals: u8,
+    pub initialized: bool,
+    pub transfer_fee: Option<RawTransferFeeConfig>,
+    pub transfer_hook_program: Option<[u8; 32]>,
+}
+
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum SupportedInstruction {
+    TransferChecked {
+        gross_atomic_units: u64,
+        decimals: u8,
+    },
+    SyncNative,
+    CloseAccount,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct NativeTransition {
+    pub account_lamports: u64,
+    pub rent_reserve_lamports: u64,
+    pub amount_before_atomic_units: u64,
+    pub amount_after_atomic_units: u64,
+}
+
+fn read_u64(bytes: &[u8]) -> Option<u64> {
+    Some(u64::from_le_bytes(bytes.try_into().ok()?))
+}
+
+fn read_u16(bytes: &[u8]) -> Option<u16> {
+    Some(u16::from_le_bytes(bytes.try_into().ok()?))
+}
+
+fn read_pubkey(bytes: &[u8]) -> Option<[u8; 32]> {
+    Some(bytes.try_into().ok()?)
+}
+
+fn tlvs(bytes: &[u8], start: usize) -> Result<BTreeMap<u16, &[u8]>, DecodeClass> {
+    let mut extensions = BTreeMap::new();
+    let mut cursor = start;
+    while cursor < bytes.len() {
+        if bytes[cursor..].iter().all(|byte| *byte == 0) {
+            break;
+        }
+        if bytes.len().saturating_sub(cursor) < 4 {
+            return Err(DecodeClass::Malformed("truncated_tlv_header"));
+        }
+        let kind =
+            read_u16(&bytes[cursor..cursor + 2]).ok_or(DecodeClass::Malformed("bad_tlv_type"))?;
+        let len = read_u16(&bytes[cursor + 2..cursor + 4])
+            .ok_or(DecodeClass::Malformed("bad_tlv_length"))? as usize;
+        let value_start = cursor + 4;
+        let value_end = value_start
+            .checked_add(len)
+            .ok_or(DecodeClass::Malformed("tlv_length_overflow"))?;
+        if value_end > bytes.len() {
+            return Err(DecodeClass::Malformed("tlv_out_of_bounds"));
+        }
+        if extensions
+            .insert(kind, &bytes[value_start..value_end])
+            .is_some()
+        {
+            return Err(DecodeClass::Malformed("duplicate_tlv_type"));
+        }
+        cursor = value_end;
+    }
+    Ok(extensions)
+}
+
+fn decode_fee_config(bytes: &[u8]) -> Result<RawTransferFeeConfig, DecodeClass> {
+    if bytes.len() != TRANSFER_FEE_CONFIG_LEN {
+        return Err(DecodeClass::Malformed("transfer_fee_config_length"));
+    }
+    let schedule = |offset: usize| -> Result<FeeSchedule, DecodeClass> {
+        let epoch =
+            read_u64(&bytes[offset..offset + 8]).ok_or(DecodeClass::Malformed("fee_epoch"))?;
+        let maximum_fee = read_u64(&bytes[offset + 8..offset + 16])
+            .ok_or(DecodeClass::Malformed("fee_maximum"))?;
+        let basis_points = read_u16(&bytes[offset + 16..offset + 18])
+            .ok_or(DecodeClass::Malformed("fee_basis_points"))?;
+        if basis_points > 10_000 {
+            return Err(DecodeClass::Malformed("fee_basis_points_out_of_range"));
+        }
+        Ok(FeeSchedule {
+            epoch,
+            maximum_fee,
+            basis_points,
+        })
+    };
+    Ok(RawTransferFeeConfig {
+        older: schedule(72)?,
+        newer: schedule(90)?,
+    })
+}
+
+pub fn decode_token_account(
+    bytes: &[u8],
+    token_2022_owner: bool,
+) -> Result<RawTokenAccount, DecodeClass> {
+    if bytes.len() < TOKEN_ACCOUNT_BASE_LEN {
+        return Err(DecodeClass::Malformed("token_account_base_truncated"));
+    }
+    let mint_pubkey =
+        read_pubkey(&bytes[..32]).ok_or(DecodeClass::Malformed("token_account_mint_pubkey"))?;
+    let authority_pubkey = read_pubkey(&bytes[32..64])
+        .ok_or(DecodeClass::Malformed("token_account_authority_pubkey"))?;
+    let amount = read_u64(&bytes[64..72]).ok_or(DecodeClass::Malformed("token_account_amount"))?;
+    let state = match bytes[108] {
+        0 => TokenAccountState::Uninitialized,
+        1 => TokenAccountState::Initialized,
+        2 => TokenAccountState::Frozen,
+        _ => return Err(DecodeClass::Malformed("token_account_state")),
+    };
+    let native_tag = u32::from_le_bytes(
+        bytes[109..113]
+            .try_into()
+            .map_err(|_| DecodeClass::Malformed("native_option_tag"))?,
+    );
+    let native_reserve = match native_tag {
+        0 => None,
+        1 => Some(read_u64(&bytes[113..121]).ok_or(DecodeClass::Malformed("native_reserve"))?),
+        _ => return Err(DecodeClass::Malformed("native_option_tag_value")),
+    };
+    if !token_2022_owner {
+        if bytes.len() != TOKEN_ACCOUNT_BASE_LEN {
+            return Err(DecodeClass::Unsupported(
+                "legacy_owner_with_extended_or_malformed_layout",
+            ));
+        }
+        return Ok(RawTokenAccount {
+            mint_pubkey,
+            authority_pubkey,
+            state,
+            amount,
+            native_reserve,
+            withheld_amount: None,
+            transfer_hook_account: None,
+        });
+    }
+    if bytes.len() == TOKEN_ACCOUNT_BASE_LEN {
+        return Ok(RawTokenAccount {
+            mint_pubkey,
+            authority_pubkey,
+            state,
+            amount,
+            native_reserve,
+            withheld_amount: None,
+            transfer_hook_account: None,
+        });
+    }
+    if bytes.len() <= ACCOUNT_TYPE_OFFSET || bytes[ACCOUNT_TYPE_OFFSET] != ACCOUNT_TYPE_ACCOUNT {
+        return Err(DecodeClass::Malformed("token_account_type"));
+    }
+    let extensions = tlvs(bytes, ACCOUNT_TYPE_OFFSET + 1)?;
+    for kind in extensions.keys() {
+        if !matches!(*kind, EXT_TRANSFER_FEE_AMOUNT | EXT_TRANSFER_HOOK_ACCOUNT) {
+            return Err(DecodeClass::Unsupported(
+                "unhandled_token_account_extension",
+            ));
+        }
+    }
+    let withheld_amount = match extensions.get(&EXT_TRANSFER_FEE_AMOUNT) {
+        Some(value) if value.len() == 8 => Some(read_u64(value).unwrap()),
+        Some(_) => return Err(DecodeClass::Malformed("transfer_fee_amount_length")),
+        None => None,
+    };
+    let transfer_hook_account = match extensions.get(&EXT_TRANSFER_HOOK_ACCOUNT) {
+        Some(value) if value.len() == 1 && value[0] <= 1 => Some(value[0] == 1),
+        Some(_) => return Err(DecodeClass::Malformed("transfer_hook_account_length")),
+        None => None,
+    };
+    Ok(RawTokenAccount {
+        mint_pubkey,
+        authority_pubkey,
+        state,
+        amount,
+        native_reserve,
+        withheld_amount,
+        transfer_hook_account,
+    })
+}
+
+pub fn decode_mint(bytes: &[u8]) -> Result<RawMint, DecodeClass> {
+    if bytes.len() < MINT_BASE_LEN {
+        return Err(DecodeClass::Malformed("mint_base_truncated"));
+    }
+    let decimals = bytes[44];
+    let initialized = match bytes[45] {
+        0 => false,
+        1 => true,
+        _ => return Err(DecodeClass::Malformed("mint_initialized_flag")),
+    };
+    if bytes.len() == MINT_BASE_LEN {
+        return Ok(RawMint {
+            decimals,
+            initialized,
+            transfer_fee: None,
+            transfer_hook_program: None,
+        });
+    }
+    if bytes.len() <= ACCOUNT_TYPE_OFFSET
+        || bytes[ACCOUNT_TYPE_OFFSET] != ACCOUNT_TYPE_MINT
+        || bytes[MINT_BASE_LEN..ACCOUNT_TYPE_OFFSET]
+            .iter()
+            .any(|byte| *byte != 0)
+    {
+        return Err(DecodeClass::Malformed("mint_account_type_or_padding"));
+    }
+    let extensions = tlvs(bytes, ACCOUNT_TYPE_OFFSET + 1)?;
+    for kind in extensions.keys() {
+        if !matches!(*kind, EXT_TRANSFER_FEE_CONFIG | EXT_TRANSFER_HOOK) {
+            return Err(DecodeClass::Unsupported("unhandled_mint_extension"));
+        }
+    }
+    let transfer_fee = match extensions.get(&EXT_TRANSFER_FEE_CONFIG) {
+        Some(value) => Some(decode_fee_config(value)?),
+        None => None,
+    };
+    let transfer_hook_program = match extensions.get(&EXT_TRANSFER_HOOK) {
+        Some(value) if value.len() == 64 => {
+            let mut program = [0; 32];
+            program.copy_from_slice(&value[32..64]);
+            (!program.iter().all(|byte| *byte == 0)).then_some(program)
+        }
+        Some(_) => return Err(DecodeClass::Malformed("transfer_hook_length")),
+        None => None,
+    };
+    if transfer_hook_program.is_some() {
+        return Err(DecodeClass::Unsupported(
+            "active_transfer_hook_runtime_semantics_unqualified",
+        ));
+    }
+    Ok(RawMint {
+        decimals,
+        initialized,
+        transfer_fee,
+        transfer_hook_program,
+    })
+}
+
+pub fn validate_transfer_roles(
+    mint: &RawMint,
+    source: &RawTokenAccount,
+    destination: &RawTokenAccount,
+    expected_mint: &[u8; 32],
+    expected_source_authority: &[u8; 32],
+    expected_destination_authority: &[u8; 32],
+    instruction_decimals: u8,
+) -> Result<(), DecodeClass> {
+    if !mint.initialized {
+        return Err(DecodeClass::Malformed("mint_uninitialized"));
+    }
+    if mint.decimals != instruction_decimals {
+        return Err(DecodeClass::Malformed("transfer_checked_decimals_mismatch"));
+    }
+    if source.state != TokenAccountState::Initialized
+        || destination.state != TokenAccountState::Initialized
+    {
+        return Err(DecodeClass::Malformed("token_account_not_initialized"));
+    }
+    if &source.mint_pubkey != expected_mint || &destination.mint_pubkey != expected_mint {
+        return Err(DecodeClass::Malformed("token_account_mint_role_mismatch"));
+    }
+    if &source.authority_pubkey != expected_source_authority
+        || &destination.authority_pubkey != expected_destination_authority
+    {
+        return Err(DecodeClass::Malformed(
+            "token_account_authority_role_mismatch",
+        ));
+    }
+    Ok(())
+}
+
+pub fn calculate_fee(schedule: &FeeSchedule, gross: u64) -> Result<u64, DecodeClass> {
+    if schedule.basis_points > 10_000 {
+        return Err(DecodeClass::Malformed("fee_basis_points_out_of_range"));
+    }
+    if gross == 0 || schedule.basis_points == 0 {
+        return Ok(0);
+    }
+    let numerator = (gross as u128)
+        .checked_mul(schedule.basis_points as u128)
+        .ok_or(DecodeClass::Malformed("fee_multiplication_overflow"))?;
+    let rounded_up = numerator
+        .checked_add(9_999)
+        .ok_or(DecodeClass::Malformed("fee_rounding_overflow"))?
+        / 10_000;
+    let rounded_up =
+        u64::try_from(rounded_up).map_err(|_| DecodeClass::Malformed("fee_conversion_overflow"))?;
+    Ok(rounded_up.min(schedule.maximum_fee))
+}
+
+pub fn schedule_for_epoch(config: &RawTransferFeeConfig, epoch: u64) -> &FeeSchedule {
+    if epoch >= config.newer.epoch {
+        &config.newer
+    } else {
+        &config.older
+    }
+}
+
+pub fn decode_supported_instruction(
+    program_is_token_2022: bool,
+    data: &[u8],
+) -> Result<SupportedInstruction, DecodeClass> {
+    match data {
+        [12, amount @ ..] if program_is_token_2022 => {
+            if amount.len() != 9 {
+                return Err(DecodeClass::Malformed("transfer_checked_data_length"));
+            }
+            Ok(SupportedInstruction::TransferChecked {
+                gross_atomic_units: read_u64(&amount[..8])
+                    .ok_or(DecodeClass::Malformed("transfer_checked_amount"))?,
+                decimals: amount[8],
+            })
+        }
+        [17] if !program_is_token_2022 => Ok(SupportedInstruction::SyncNative),
+        [9] if !program_is_token_2022 => Ok(SupportedInstruction::CloseAccount),
+        [] => Err(DecodeClass::Malformed("empty_token_instruction")),
+        _ => Err(DecodeClass::Unsupported(
+            "token_instruction_outside_declared_subset",
+        )),
+    }
+}
+
+pub fn decode_transfer_hook_execute(data: &[u8]) -> Result<u64, DecodeClass> {
+    if data.len() != 16 || data[..8] != TRANSFER_HOOK_EXECUTE_DISCRIMINATOR {
+        return Err(DecodeClass::Malformed("transfer_hook_execute_encoding"));
+    }
+    read_u64(&data[8..]).ok_or(DecodeClass::Malformed("transfer_hook_execute_amount"))
+}
+
+/// Compute the native token amount in atomic token units from lamports and a
+/// rent-exempt reserve expressed in lamports, following legacy Token v3.5.0.
+pub fn expected_sync_native_amount(
+    account_lamports: u64,
+    rent_reserve_lamports: u64,
+    amount_before_atomic_units: u64,
+) -> Result<NativeTransition, DecodeClass> {
+    let amount_after_atomic_units = account_lamports
+        .checked_sub(rent_reserve_lamports)
+        .ok_or(DecodeClass::Malformed("native_lamports_below_rent_reserve"))?;
+    if amount_after_atomic_units < amount_before_atomic_units {
+        return Err(DecodeClass::Malformed("sync_native_amount_decreased"));
+    }
+    Ok(NativeTransition {
+        account_lamports,
+        rent_reserve_lamports,
+        amount_before_atomic_units,
+        amount_after_atomic_units,
+    })
+}
+
+/// CloseAccount transfers the whole account lamport balance, including the
+/// reserve. A non-native account must have zero token amount first.
+pub fn expected_close_lamports(
+    is_native: bool,
+    amount_atomic_units: u64,
+    account_lamports: u64,
+) -> Result<u64, DecodeClass> {
+    if !is_native && amount_atomic_units != 0 {
+        return Err(DecodeClass::Malformed(
+            "non_native_account_has_token_balance",
+        ));
+    }
+    Ok(account_lamports)
+}
+
+pub fn validate_native_account_roles(
+    account: &RawTokenAccount,
+    expected_native_mint: &[u8; 32],
+    expected_authority: &[u8; 32],
+    rent_reserve_lamports: u64,
+) -> Result<(), DecodeClass> {
+    if account.state != TokenAccountState::Initialized {
+        return Err(DecodeClass::Malformed(
+            "native_token_account_not_initialized",
+        ));
+    }
+    if &account.mint_pubkey != expected_native_mint {
+        return Err(DecodeClass::Malformed("native_mint_role_mismatch"));
+    }
+    if &account.authority_pubkey != expected_authority {
+        return Err(DecodeClass::Malformed("native_authority_role_mismatch"));
+    }
+    if account.native_reserve != Some(rent_reserve_lamports) {
+        return Err(DecodeClass::Malformed("native_rent_reserve_mismatch"));
+    }
+    Ok(())
+}
