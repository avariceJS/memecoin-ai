+            Err(DecodeClass::Malformed("native_sync_close_state_mismatch"))
+        );
+
+        let mut below_reserve = base.clone();
+        below_reserve.before_sync.as_mut().unwrap().lamports = Some(2_038);
+        assert_eq!(
+            derive_legacy_wsol_arithmetic(&below_reserve),
+            Err(DecodeClass::Malformed("native_lamports_below_rent_reserve"))
+        );
+
+        let mut overflow = base;
+        overflow.close_destination_before.as_mut().unwrap().lamports = Some(u64::MAX);
+        overflow.close_destination_after.as_mut().unwrap().lamports = Some(0);
+        assert_eq!(
+            derive_legacy_wsol_arithmetic(&overflow),
+            Err(DecodeClass::Malformed(
+                "close_destination_lamports_decreased"
+            ))
+        );
+    }
+}
