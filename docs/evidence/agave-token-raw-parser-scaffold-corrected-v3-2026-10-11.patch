+    #[test]
+    fn account_extensions_decode_withheld_and_hook_state() {
+        let mut account = vec![0; 166];
+        account[64..72].copy_from_slice(&42u64.to_le_bytes());
+        account[165] = ACCOUNT_TYPE_ACCOUNT;
+        account.extend(tlv(EXT_TRANSFER_FEE_AMOUNT, &11u64.to_le_bytes()));
+        account.extend(tlv(EXT_TRANSFER_HOOK_ACCOUNT, &[1]));
+        let decoded = decode_token_account(&account, true).unwrap();
+        assert_eq!(decoded.amount, 42);
+        assert_eq!(decoded.withheld_amount, Some(11));
+        assert_eq!(decoded.transfer_hook_account, Some(true));
+
+        let mut duplicate = account.clone();
+        duplicate.extend(tlv(EXT_TRANSFER_FEE_AMOUNT, &0u64.to_le_bytes()));
+        assert_eq!(
