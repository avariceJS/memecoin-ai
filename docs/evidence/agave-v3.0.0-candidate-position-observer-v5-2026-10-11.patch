+fn verify_trace(trace: &Trace) -> Result<(), &'static str> {
+    if trace.schema != "agave_candidate_position_transaction_trace_v5"
+        || trace.attempt_ordinal.is_none()
+        || !trace.sealed
+        || !trace.complete
+        || trace.terminal_status.is_none()
+        || !trace.selected_set_complete
+        || trace.message_hash.is_none()
+        || trace.claim_scope != "runtime_execution_attempt_only"
+    {
+        return Err("unsealed_or_incomplete");
+    }
+    let mut stack = Vec::<usize>::new();
+    let mut terminal_count = 0usize;
+    let mut final_instruction_count = 0usize;
+    let mut expected_frame_id = 0usize;
+    let mut frame_parents = std::collections::BTreeMap::<usize, Option<usize>>::new();
+    let mut frame_heights = std::collections::BTreeMap::<usize, usize>::new();
+    let mut frame_program_ids = std::collections::BTreeMap::<usize, Option<String>>::new();
+    let mut frame_instruction_data = std::collections::BTreeMap::<usize, Option<Vec<u8>>>::new();
+    let mut top_level_frames = std::collections::BTreeSet::<usize>::new();
+    let mut top_level_frame_order = Vec::<usize>::new();
+    let mut final_seen = std::collections::BTreeSet::<usize>::new();
+    let mut exec_result = std::collections::BTreeMap::<usize, bool>::new();
+    let mut pre_seen = std::collections::BTreeSet::<usize>::new();
+    let mut post_seen = std::collections::BTreeSet::<usize>::new();
+    let mut pop_result = std::collections::BTreeMap::<usize, bool>::new();
+    for (index, event) in trace.events.iter().enumerate() {
+        if event.schema != "agave_candidate_position_event_v5"
+            || event.session_id != trace.session_id
+            || event.execution_id != trace.execution_id
+            || event.transaction_id != trace.transaction_id
+            || event.attempt_ordinal != trace.attempt_ordinal
+            || event.recent_blockhash != trace.recent_blockhash
+        {
+            return Err("cross_transaction_bleed");
+        }
+        if event.event_sequence != index as u64 {
+            return Err("sequence_gap_or_duplicate");
+        }
+        match event.kind.as_str() {
+            "push_attempt" => {
+                let frame = event.frame_id.ok_or("missing_frame")?;
+                if event.parent_frame_id != stack.last().copied()
+                    || frame != expected_frame_id
+                    || event.stack_height != stack.len() + 1
+                    || event.program_id.is_none()
+                    || event.instruction_data.is_none()
+                {
+                    return Err("parent_or_ordinal_mismatch");
+                }
+                expected_frame_id += 1;
+                frame_parents.insert(frame, event.parent_frame_id);
+                frame_program_ids.insert(frame, event.program_id.clone());
+                frame_instruction_data.insert(frame, event.instruction_data.clone());
+                if event.parent_frame_id.is_none() {
+                    if top_level_frame_order
+                        .last()
+                        .is_some_and(|previous| !final_seen.contains(previous))
+                    {
+                        return Err("root_before_prior_final");
+                    }
+                    top_level_frames.insert(frame);
+                    top_level_frame_order.push(frame);
+                } else {
+                    let parent = event.parent_frame_id.unwrap();
+                    if !pre_seen.contains(&parent) || exec_result.contains_key(&parent) {
+                        return Err("child_pushed_outside_parent_execution");
+                    }
+                }
+                match event.outcome.as_deref() {
+                    Some("push_success") => {
+                        frame_heights.insert(frame, stack.len() + 1);
+                        verify_account_roles(trace, event)?;
+                        stack.push(frame);
+                    }
+                    Some(value) if value.starts_with("push_error:") => return Err("failed_push"),
+                    _ => return Err("malformed_push_outcome"),
+                }
+            }
+            "pre_execution" => {
+                let frame = event.frame_id.ok_or("missing_frame")?;
+                if stack.last().copied() != Some(frame)
+                    || frame_parents.get(&frame) != Some(&event.parent_frame_id)
+                    || frame_heights.get(&frame) != Some(&event.stack_height)
+                    || frame_program_ids.get(&frame) != Some(&event.program_id)
+                    || frame_instruction_data.get(&frame) != Some(&event.instruction_data)
+                    || !pre_seen.insert(frame)
+                    || event.program_id.is_none()
+                    || event.instruction_data.is_none()
+                {
+                    return Err("pre_frame_or_duplicate_mismatch");
+                }
+                verify_account_roles(trace, event)?;
+            }
+            "execution_return" => {
+                let frame = event.frame_id.ok_or("missing_frame")?;
+                if stack.last().copied() != Some(frame)
+                    || frame_parents.get(&frame) != Some(&event.parent_frame_id)
+                    || frame_heights.get(&frame) != Some(&event.stack_height)
+                    || frame_program_ids.get(&frame) != Some(&event.program_id)
+                    || frame_instruction_data.get(&frame) != Some(&event.instruction_data)
+                    || !pre_seen.contains(&frame)
+                    || exec_result.contains_key(&frame)
+                {
+                    return Err("execution_order");
+                }
+                verify_account_roles(trace, event)?;
+                let result = match event.outcome.as_deref() {
+                    Some("returned_success") => true,
+                    Some(value) if value.starts_with("returned_error:") => false,
+                    _ => return Err("malformed_execution_result"),
+                };
+                exec_result.insert(frame, result);
+            }
+            "post_execution_pre_pop" => {
+                let frame = event.frame_id.ok_or("missing_frame")?;
+                if stack.last().copied() != Some(frame)
+                    || frame_parents.get(&frame) != Some(&event.parent_frame_id)
+                    || frame_heights.get(&frame) != Some(&event.stack_height)
+                    || frame_program_ids.get(&frame) != Some(&event.program_id)
+                    || frame_instruction_data.get(&frame) != Some(&event.instruction_data)
+                    || !exec_result.contains_key(&frame)
+                    || !post_seen.insert(frame)
+                {
+                    return Err("post_order");
+                }
+                verify_account_roles(trace, event)?;
+            }
+            "pop_outcome" => {
+                let frame = event.frame_id.ok_or("missing_frame")?;
+                if stack.last().copied() != Some(frame)
+                    || frame_parents.get(&frame) != Some(&event.parent_frame_id)
+                    || frame_heights.get(&frame) != Some(&event.stack_height)
+                    || frame_program_ids.get(&frame) != Some(&event.program_id)
+                    || frame_instruction_data.get(&frame) != Some(&event.instruction_data)
+                    || !post_seen.contains(&frame)
+                    || pop_result.contains_key(&frame)
+                {
+                    return Err("pop_order");
+                }
+                verify_account_roles(trace, event)?;
+                match event.outcome.as_deref() {
+                    Some("pop_success") => {
+                        pop_result.insert(frame, true);
+                        stack.pop();
+                    }
+                    Some(value) if value.starts_with("pop_error:") => return Err("failed_pop"),
+                    _ => return Err("malformed_pop_outcome"),
+                }
+            }
+            "final_instruction" => {
+                final_instruction_count += 1;
+                if !stack.is_empty() {
+                    return Err("nonempty_stack_at_instruction_terminal");
+                }
+                let frame = event.frame_id.ok_or("missing_top_frame")?;
+                if !top_level_frames.contains(&frame)
+                    || event.parent_frame_id.is_some()
+                    || frame_heights.get(&frame) != Some(&event.stack_height)
+                    || frame_program_ids.get(&frame) != Some(&event.program_id)
+                    || frame_instruction_data.get(&frame) != Some(&event.instruction_data)
+                    || top_level_frame_order.get(final_instruction_count - 1) != Some(&frame)
+                    || !final_seen.insert(frame)
+                    || !pre_seen.contains(&frame)
+                    || pop_result.get(&frame) != Some(&true)
+                {
+                    return Err("final_without_completed_top_frame");
+                }
+                verify_account_roles(trace, event)?;
+                let execution_ok = exec_result
+                    .get(&frame)
+                    .copied()
+                    .ok_or("missing_execution_result")?;
+                let succeeded = match event.outcome.as_deref() {
+                    Some("instruction_success") => true,
+                    Some(value) if value.starts_with("instruction_error:") => false,
+                    _ => return Err("malformed_instruction_terminal"),
+                };
+                if succeeded != execution_ok {
+                    return Err("wrong_return_precedence");
+                }
+            }
+            "transaction_terminal" => {
+                if !stack.is_empty()
+                    || terminal_count != 0
+                    || event.frame_id.is_some()
+                    || event.parent_frame_id.is_some()
+                    || event.stack_height != 0
+                    || !event.accounts.is_empty()
+                {
+                    return Err("transaction_order");
+                }
+                let success = match event.outcome.as_deref() {
+                    Some("runtime_success") => true,
+                    Some(value) if value.starts_with("runtime_error:") => false,
+                    _ => return Err("malformed_runtime_terminal"),
+                };
+                if trace.terminal_status.as_deref()
+                    != Some(if success {
+                        "runtime_success"
+                    } else {
+                        "runtime_failure"
+                    })
+                {
+                    return Err("runtime_terminal_status_mismatch");
+                }
+                terminal_count += 1;
+            }
+            "aborted" => return Err("aborted_trace"),
+            _ => return Err("unknown_event"),
+        }
+    }
+    if terminal_count != 1
+        || final_instruction_count != trace.attempted_top_level_instructions
+        || final_instruction_count == 0
+        || final_instruction_count > trace.expected_instruction_count
+        || final_seen.len() != top_level_frames.len()
+        || trace.events.last().map(|event| event.kind.as_str()) != Some("transaction_terminal")
+    {
+        return Err("terminal_missing_or_duplicate");
+    }
+    let terminal_success = trace.terminal_status.as_deref() == Some("runtime_success");
+    let expected_not_reached = if terminal_success {
+        if final_instruction_count != trace.expected_instruction_count {
+            return Err("successful_trace_truncated");
+        }
+        Vec::new()
+    } else {
+        (final_instruction_count..trace.expected_instruction_count).collect::<Vec<_>>()
+    };
+    if trace.not_reached_top_level_instructions != expected_not_reached {
+        return Err("not_reached_instruction_mismatch");
+    }
+    Ok(())
+}
