+            &account_list_mutation,
+            &fixture_signature,
+            &fixture_message_hash,
+            &run_nonce,
+            0,
+            &fixture_message_account_keys,
+            &banks_result,
+        ),
+        Err("fixture_identity_mismatch")
+    );
+    let mut missing_available_field = trace.clone();
+    missing_available_field.events[pre]
+        .accounts
+        .iter_mut()
+        .find(|account| account.role.starts_with("transaction:"))
+        .unwrap()
+        .data = None;
+    assert_eq!(
+        verify_trace(&missing_available_field),
+        Err("available_account_field_missing")
+    );
+    for (kind, field) in [
+        ("push_attempt", "data"),
+        ("execution_return", "lamports"),
+        ("pop_outcome", "unavailable"),
+        ("final_instruction", "data"),
+    ] {
+        let mut phase_account_mutation = trace.clone();
+        let event_index = phase_account_mutation
+            .events
+            .iter()
+            .position(|event| event.kind == kind)
+            .unwrap();
+        let account = phase_account_mutation.events[event_index]
+            .accounts
+            .iter_mut()
+            .find(|account| account.role.starts_with("transaction:"))
+            .unwrap();
+        match field {
+            "data" => account.data = None,
+            "lamports" => account.lamports = None,
+            "unavailable" => {
+                account.available = false;
+                account.unavailable_reason = Some("synthetic_borrow_failure".into());
+            }
+            _ => unreachable!(),
+        }
+        assert!(verify_trace(&phase_account_mutation).is_err());
+    }
+    let mut program_id_mutation = trace.clone();
+    let pre_program_id = program_id_mutation
+        .events
+        .iter()
+        .position(|event| event.kind == "pre_execution")
+        .unwrap();
+    program_id_mutation.events[pre_program_id].program_id = Some(Pubkey::new_unique().to_string());
+    assert!(verify_trace(&program_id_mutation).is_err());
+    let mut instruction_data_mutation = trace.clone();
+    let pre_instruction_data = instruction_data_mutation
+        .events
+        .iter()
+        .position(|event| event.kind == "pre_execution")
+        .unwrap();
+    instruction_data_mutation.events[pre_instruction_data].instruction_data = Some(vec![0xff]);
+    assert!(verify_trace(&instruction_data_mutation).is_err());
+    let mut parent_order_mutation = trace.clone();
+    let parent_return_index = parent_order_mutation
+        .events
+        .iter()
+        .position(|event| event.kind == "execution_return" && event.frame_id == Some(0))
+        .unwrap();
+    let child_push_index = parent_order_mutation
+        .events
+        .iter()
+        .position(|event| event.kind == "push_attempt" && event.parent_frame_id == Some(0))
+        .unwrap();
+    let parent_return = parent_order_mutation.events[parent_return_index].clone();
+    parent_order_mutation
+        .events
+        .insert(child_push_index, parent_return);
+    for (sequence, event) in parent_order_mutation.events.iter_mut().enumerate() {
+        event.event_sequence = sequence as u64;
+    }
+    assert_eq!(
+        verify_trace(&parent_order_mutation),
+        Err("child_pushed_outside_parent_execution")
+    );
+    let mut repeated_signed_tx = trace.clone();
+    repeated_signed_tx.attempt_ordinal = Some(1);
+    repeated_signed_tx.execution_id = format!(
+        "{}:{}:{}:attempt:1",
+        run_nonce, fixture_signature, fixture_message_hash
+    );
+    assert_eq!(
+        verify_fixture_binding(
+            &repeated_signed_tx,
+            &fixture_signature,
+            &fixture_message_hash,
+            &run_nonce,
+            0,
+            &fixture_message_account_keys,
+            &banks_result,
+        ),
+        Err("fixture_identity_mismatch")
+    );
+    let observed = &trace.events;
+    assert_eq!(
+        observed
+            .iter()
+            .filter(|event| event.kind == "push_attempt")
+            .count(),
+        2
+    );
+    assert_eq!(
+        observed
+            .iter()
+            .filter(|event| event.kind == "pre_execution")
+            .count(),
+        2
+    );
+    assert_eq!(
+        observed
+            .iter()
+            .filter(|event| event.kind == "execution_return")
+            .count(),
+        2
+    );
+    assert_eq!(
+        observed
+            .iter()
+            .filter(|event| event.kind == "post_execution_pre_pop")
+            .count(),
+        2
+    );
+    assert_eq!(
+        observed
+            .iter()
+            .filter(|event| event.kind == "pop_outcome")
+            .count(),
+        2
+    );
+    assert_eq!(
+        observed
+            .iter()
+            .filter(|event| event.kind == "final_instruction")
+            .count(),
+        1
+    );
+    if let Some(path) = std::env::var_os("BRAIN_SENSES_AGAVE_WITNESS_CAPTURE") {
+        write_private_capture(path.into(), &trace);
+    }
+}
