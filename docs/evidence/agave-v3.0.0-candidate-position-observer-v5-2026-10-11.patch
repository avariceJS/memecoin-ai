+fn rent_state_failure_after_success(
+    _program_id: &Pubkey,
+    accounts: &[AccountInfo],
+    _input: &[u8],
+) -> ProgramResult {
+    let mut source_lamports = accounts[0].try_borrow_mut_lamports()?;
+    let mut destination_lamports = accounts[1].try_borrow_mut_lamports()?;
+    let transfer = **source_lamports - 1;
+    **source_lamports = 1;
+    **destination_lamports += transfer;
+    Ok(())
+}
