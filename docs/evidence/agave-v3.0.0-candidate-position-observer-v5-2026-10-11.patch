+    let second = trace_from_banks_result(&second_result);
+    verify_trace(&first).unwrap();
+    verify_trace(&second).unwrap();
+    assert_ne!(first.transaction_id, second.transaction_id);
+    assert_ne!(first.attempt_ordinal, second.attempt_ordinal);
+    assert_ne!(first.execution_id, second.execution_id);
+    assert_eq!(first.session_id, second.session_id);
+    assert!(first
+        .events
+        .iter()
+        .all(|event| event.transaction_id == first.transaction_id));
+    assert!(second
+        .events
+        .iter()
+        .all(|event| event.transaction_id == second.transaction_id));
+}
