diff --git a/program-runtime/src/invoke_context.rs b/program-runtime/src/invoke_context.rs
index 93575e1..abe536d 100644
--- a/program-runtime/src/invoke_context.rs
+++ b/program-runtime/src/invoke_context.rs
@@ -183,6 +183,964 @@ pub struct SerializedAccountMetadata {
 }
 
 /// Main pipeline from runtime to program execution.
+#[cfg(feature = "dev-context-only-utils")]
+pub mod candidate_position_witness {
+    use {
+        super::InvokeContext,
+        serde::{Deserialize, Serialize},
+        solana_account::ReadableAccount,
+        solana_instruction::error::InstructionError,
+        solana_transaction_context::IndexOfAccount,
+        std::sync::{Arc, Mutex},
+    };
+
+    const MAX_TRACE_EVENTS: usize = 2_048;
+    const MAX_TRACE_ACCOUNTS_PER_EVENT: usize = 256;
+    const MAX_TRACE_ACCOUNT_SNAPSHOTS: usize = 4_096;
+    const MAX_ACCOUNT_DATA_BYTES: usize = 256 * 1024;
+    const MAX_TRACE_ACCOUNT_DATA_BYTES: usize = 4 * 1024 * 1024;
+
+    #[derive(Clone, Debug, Deserialize, Serialize)]
+    pub struct AccountSnapshot {
+        pub role: String,
+        pub instruction_account_index: Option<u16>,
+        pub transaction_account_index: Option<u16>,
+        pub pubkey: String,
+        pub available: bool,
+        pub unavailable_reason: Option<String>,
+        pub lamports: Option<u64>,
+        pub owner: Option<String>,
+        pub executable: Option<bool>,
+        pub rent_epoch: Option<u64>,
+        pub data: Option<Vec<u8>>,
+    }
+
+    #[derive(Clone, Debug, Deserialize, Serialize)]
+    pub struct Boundary {
+        pub schema: String,
+        pub session_id: String,
+        pub execution_id: String,
+        pub transaction_id: String,
+        pub attempt_ordinal: Option<u64>,
+        pub recent_blockhash: String,
+        pub event_sequence: u64,
+        pub kind: String,
+        pub frame_id: Option<usize>,
+        pub parent_frame_id: Option<usize>,
+        pub stack_height: usize,
+        pub program_id: Option<String>,
+        pub instruction_data: Option<Vec<u8>>,
+        pub outcome: Option<String>,
+        pub accounts: Vec<AccountSnapshot>,
+        pub instruction_account_indices: Vec<u16>,
+    }
+
+    #[derive(Clone, Debug, Deserialize, Serialize)]
+    pub struct Trace {
+        pub schema: String,
+        pub session_id: String,
+        pub execution_id: String,
+        pub transaction_id: String,
+        pub message_hash: Option<String>,
+        pub attempt_ordinal: Option<u64>,
+        pub recent_blockhash: String,
+        pub selected_accounts: Vec<String>,
+        pub selected_set_complete: bool,
+        pub expected_instruction_count: usize,
+        pub attempted_top_level_instructions: usize,
+        pub not_reached_top_level_instructions: Vec<usize>,
+        pub events: Vec<Boundary>,
+        pub terminal_status: Option<String>,
+        pub incomplete_reason: Option<String>,
+        pub captured_account_data_bytes: usize,
+        pub captured_instruction_data_bytes: usize,
+        pub captured_account_snapshots: usize,
+        pub claim_scope: String,
+        pub sealed: bool,
+        pub complete: bool,
+    }
+
+    #[derive(Clone)]
+    pub struct ObserverHandle {
+        trace: Arc<Mutex<Trace>>,
+        active_frames: Arc<Mutex<Vec<usize>>>,
+    }
+
+    impl ObserverHandle {
+        pub fn new(
+            session_id: String,
+            transaction_id: String,
+            message_hash: Option<String>,
+            recent_blockhash: String,
+            message_account_keys: Vec<String>,
+            loaded_account_keys: Vec<String>,
+            expected_instruction_count: usize,
+            attempt_ordinal: Option<u64>,
+        ) -> Self {
+            let invalid_message_hash = message_hash.is_none();
+            let selected_account_count = message_account_keys.len();
+            let account_keys_mismatch = message_account_keys != loaded_account_keys;
+            let execution_id = format!(
+                "{session_id}:{transaction_id}:{}:attempt:{}",
+                message_hash.as_deref().unwrap_or("missing-message-hash"),
+                attempt_ordinal.map_or_else(|| "missing".to_owned(), |value| value.to_string())
+            );
+            let observer = Self {
+                trace: Arc::new(Mutex::new(Trace {
+                    schema: "agave_candidate_position_transaction_trace_v5".into(),
+                    session_id,
+                    execution_id,
+                    transaction_id,
+                    message_hash,
+                    attempt_ordinal,
+                    recent_blockhash,
+                    selected_accounts: message_account_keys,
+                    selected_set_complete: true,
+                    expected_instruction_count,
+                    attempted_top_level_instructions: 0,
+                    not_reached_top_level_instructions: Vec::new(),
+                    events: Vec::new(),
+                    terminal_status: None,
+                    incomplete_reason: None,
+                    captured_account_data_bytes: 0,
+                    captured_instruction_data_bytes: 0,
+                    captured_account_snapshots: 0,
+                    claim_scope: "runtime_execution_attempt_only".into(),
+                    sealed: false,
+                    complete: false,
+                })),
+                active_frames: Arc::new(Mutex::new(Vec::new())),
+            };
+            if invalid_message_hash {
+                observer.abort("missing_signed_message_hash");
+            } else if attempt_ordinal.is_none() {
+                observer.abort("missing_attempt_ordinal");
+            } else if account_keys_mismatch {
+                observer.abort("signed_message_loaded_account_keys_mismatch");
+            } else if selected_account_count > MAX_TRACE_ACCOUNTS_PER_EVENT {
+                observer.abort("selected_account_limit");
+            } else if expected_instruction_count > MAX_TRACE_EVENTS / 5 {
+                observer.abort("instruction_count_limit");
+            }
+            observer
+        }
+
+        pub fn snapshot(&self) -> Result<Trace, &'static str> {
+            let mut trace = match self.trace.lock() {
+                Ok(trace) => trace,
+                Err(poisoned) => {
+                    let mut trace = poisoned.into_inner();
+                    Self::mark_aborted_locked(&mut trace, "observer_lock_poisoned");
+                    self.trace.clear_poison();
+                    trace
+                }
+            };
+            if !trace.sealed {
+                Self::mark_aborted_locked(&mut trace, "observer_snapshot_before_seal");
+            }
+            Ok(trace.clone())
+        }
+
+        pub fn abort(&self, reason: &str) {
+            let mut trace = match self.trace.lock() {
+                Ok(trace) => trace,
+                Err(poisoned) => {
+                    self.trace.clear_poison();
+                    poisoned.into_inner()
+                }
+            };
+            if !trace.sealed {
+                Self::mark_aborted_locked(&mut trace, reason);
+            }
+        }
+
+        pub fn seal_transaction(&self, status: &Result<(), String>) {
+            let mut trace = match self.trace.lock() {
+                Ok(trace) => trace,
+                Err(poisoned) => {
+                    let mut trace = poisoned.into_inner();
+                    Self::mark_aborted_locked(&mut trace, "observer_lock_poisoned");
+                    self.trace.clear_poison();
+                    return;
+                }
+            };
+            if trace.sealed {
+                return;
+            }
+            if !trace.selected_set_complete {
+                Self::mark_aborted_locked(&mut trace, "selected_set_incomplete");
+                return;
+            }
+            let active_frames = match self.active_frames.lock() {
+                Ok(frames) => frames.len(),
+                Err(_) => {
+                    Self::mark_aborted_locked(&mut trace, "observer_frame_lock_poisoned");
+                    return;
+                }
+            };
+            let final_instructions = trace
+                .events
+                .iter()
+                .filter(|event| event.kind == "final_instruction")
+                .count();
+            let complete =
+                active_frames == 0 && final_instructions == trace.attempted_top_level_instructions;
+            if !complete {
+                let reason = if active_frames != 0 {
+                    "unbalanced_stack_at_terminal"
+                } else {
+                    "instruction_trace_truncated"
+                };
+                Self::append_locked(
+                    &mut trace,
+                    "aborted",
+                    None,
+                    None,
+                    None,
+                    None,
+                    None,
+                    Vec::new(),
+                    Some(reason.into()),
+                );
+                trace.terminal_status = Some(format!("aborted:{reason}"));
+                trace.incomplete_reason = Some(reason.to_owned());
+                trace.sealed = true;
+                trace.complete = false;
+                return;
+            }
+            if status.is_ok()
+                && trace.attempted_top_level_instructions != trace.expected_instruction_count
+            {
+                Self::mark_aborted_locked(
+                    &mut trace,
+                    "successful_transaction_instruction_truncated",
+                );
+                return;
+            }
+            if status.is_err() {
+                trace.not_reached_top_level_instructions = (trace.attempted_top_level_instructions
+                    ..trace.expected_instruction_count)
+                    .collect();
+            }
+            if let Err(reason) = validate_attempt_trace(&trace) {
+                Self::mark_aborted_locked(&mut trace, reason);
+                return;
+            }
+            let successful = status.is_ok();
+            Self::append_locked(
+                &mut trace,
+                "transaction_terminal",
+                None,
+                None,
+                None,
+                None,
+                None,
+                Vec::new(),
+                Some(match status {
+                    Ok(()) => "runtime_success".to_owned(),
+                    Err(error) => format!("runtime_error:{error}"),
+                }),
+            );
+            trace.terminal_status = Some(if successful {
+                "runtime_success".into()
+            } else {
+                "runtime_failure".into()
+            });
+            trace.sealed = true;
+            trace.complete = true;
+        }
+
+        fn mark_aborted_locked(trace: &mut Trace, reason: &str) {
+            if !trace.sealed {
+                Self::append_locked(
+                    trace,
+                    "aborted",
+                    None,
+                    None,
+                    None,
+                    None,
+                    None,
+                    Vec::new(),
+                    Some(reason.to_owned()),
+                );
+                trace.terminal_status = Some(format!("aborted:{reason}"));
+                trace.sealed = true;
+                trace.complete = false;
+            }
+        }
+
+        fn append_locked(
+            trace: &mut Trace,
+            kind: &'static str,
+            frame_id: Option<usize>,
+            parent_frame_id: Option<usize>,
+            stack_height: Option<usize>,
+            program_id: Option<String>,
+            instruction_data: Option<Vec<u8>>,
+            accounts: Vec<AccountSnapshot>,
+            outcome: Option<String>,
+        ) {
+            let indices = accounts
+                .iter()
+                .filter(|account| account.role.starts_with("instruction:"))
+                .filter_map(|account| account.transaction_account_index)
+                .collect();
+            let sequence = trace.events.len() as u64;
+            trace.events.push(Boundary {
+                schema: "agave_candidate_position_event_v5".into(),
+                session_id: trace.session_id.clone(),
+                execution_id: trace.execution_id.clone(),
+                transaction_id: trace.transaction_id.clone(),
+                attempt_ordinal: trace.attempt_ordinal,
+                recent_blockhash: trace.recent_blockhash.clone(),
+                event_sequence: sequence,
+                kind: kind.into(),
+                frame_id,
+                parent_frame_id,
+                stack_height: stack_height.unwrap_or_default(),
+                program_id,
+                instruction_data,
+                outcome,
+                accounts,
+                instruction_account_indices: indices,
+            });
+        }
+
+        fn record_context(
+            &self,
+            context: &InvokeContext<'_>,
+            kind: &'static str,
+            frame_id: usize,
+            parent_frame_id: Option<usize>,
+            outcome: Option<String>,
+        ) {
+            let instruction = match context
+                .transaction_context
+                .get_instruction_context_at_index_in_trace(frame_id)
+            {
+                Ok(instruction) => instruction,
+                Err(_)
+                    if kind == "push_attempt"
+                        && outcome
+                            .as_deref()
+                            .is_some_and(|value| value.starts_with("push_error:")) =>
+                {
+                    let trace = self.trace.lock();
+                    let Ok(mut trace) = trace else {
+                        self.abort("observer_lock_poisoned");
+                        return;
+                    };
+                    if trace.events.len() >= MAX_TRACE_EVENTS - 1 {
+                        Self::mark_aborted_locked(&mut trace, "event_limit");
+                        return;
+                    }
+                    Self::append_locked(
+                        &mut trace,
+                        kind,
+                        Some(frame_id),
+                        parent_frame_id,
+                        Some(context.transaction_context.get_instruction_stack_height()),
+                        None,
+                        None,
+                        Vec::new(),
+                        outcome,
+                    );
+                    Self::mark_aborted_locked(&mut trace, "failed_push_context_unavailable");
+                    return;
+                }
+                Err(_) => {
+                    self.abort("missing_instruction_context");
+                    return;
+                }
+            };
+            let program_id = match instruction.get_program_key() {
+                Ok(program_id) => program_id.to_string(),
+                Err(_) => {
+                    self.abort("missing_instruction_program_id");
+                    return;
+                }
+            };
+            let raw_instruction_data = instruction.get_instruction_data();
+            if raw_instruction_data.len() > MAX_ACCOUNT_DATA_BYTES {
+                self.abort("instruction_data_limit");
+                return;
+            }
+            let instruction_data = raw_instruction_data.to_vec();
+            let stack_height = instruction.get_stack_height();
+            let mut instruction_indices = Vec::new();
+            let mut instruction_index_failure = false;
+            for index in 0..instruction.get_number_of_instruction_accounts() {
+                match instruction.get_index_of_instruction_account_in_transaction(index) {
+                    Ok(transaction_index) => instruction_indices.push(transaction_index),
+                    Err(_) => instruction_index_failure = true,
+                }
+            }
+            let trace = self.trace.lock();
+            let Ok(mut trace) = trace else {
+                self.abort("observer_lock_poisoned");
+                return;
+            };
+            if trace.sealed {
+                return;
+            }
+            if trace.events.len() >= MAX_TRACE_EVENTS - 1 {
+                Self::mark_aborted_locked(&mut trace, "event_limit");
+                return;
+            }
+            let next_instruction_bytes = trace
+                .captured_instruction_data_bytes
+                .saturating_add(instruction_data.len());
+            if next_instruction_bytes > MAX_TRACE_ACCOUNT_DATA_BYTES {
+                Self::mark_aborted_locked(&mut trace, "instruction_capture_byte_limit");
+                return;
+            }
+            trace.captured_instruction_data_bytes = next_instruction_bytes;
+            let expected = trace.selected_accounts.clone();
+            let instruction_account_count =
+                usize::from(instruction.get_number_of_instruction_accounts());
+            if expected.len() + instruction_account_count > MAX_TRACE_ACCOUNTS_PER_EVENT {
+                trace.selected_set_complete = false;
+                Self::mark_aborted_locked(&mut trace, "account_snapshot_limit");
+                return;
+            }
+            let mut account_snapshots =
+                Vec::with_capacity(expected.len() + instruction_account_count);
+            let mut selected_accounts_available = !instruction_index_failure;
+            for (index, expected_key) in expected.iter().enumerate() {
+                let transaction_index = index as IndexOfAccount;
+                let actual_key = context
+                    .transaction_context
+                    .get_key_of_account_at_index(transaction_index)
+                    .ok()
+                    .map(|key| key.to_string());
+                let is_instruction_listed = instruction_indices.contains(&transaction_index);
+                let role = if is_instruction_listed {
+                    format!("transaction:{index}")
+                } else {
+                    format!("transaction_unlisted:{index}")
+                };
+                let snapshot = match context
+                    .transaction_context
+                    .accounts()
+                    .try_borrow(transaction_index)
+                {
+                    Ok(account) if actual_key.as_deref() == Some(expected_key.as_str()) => {
+                        let data = account.data();
+                        let next_total =
+                            trace.captured_account_data_bytes.saturating_add(data.len());
+                        if data.len() > MAX_ACCOUNT_DATA_BYTES
+                            || next_total > MAX_TRACE_ACCOUNT_DATA_BYTES
+                        {
+                            selected_accounts_available = false;
+                            AccountSnapshot {
+                                role,
+                                instruction_account_index: None,
+                                transaction_account_index: Some(transaction_index),
+                                pubkey: expected_key.clone(),
+                                available: false,
+                                unavailable_reason: Some("account_data_capture_limit".into()),
+                                lamports: None,
+                                owner: None,
+                                executable: None,
+                                rent_epoch: None,
+                                data: None,
+                            }
+                        } else {
+                            trace.captured_account_data_bytes = next_total;
+                            AccountSnapshot {
+                                role,
+                                instruction_account_index: None,
+                                transaction_account_index: Some(transaction_index),
+                                pubkey: expected_key.clone(),
+                                available: true,
+                                unavailable_reason: None,
+                                lamports: Some(account.lamports()),
+                                owner: Some(account.owner().to_string()),
+                                executable: Some(account.executable()),
+                                rent_epoch: Some(account.rent_epoch()),
+                                data: Some(data.to_vec()),
+                            }
+                        }
+                    }
+                    Ok(_) => AccountSnapshot {
+                        role,
+                        instruction_account_index: None,
+                        transaction_account_index: Some(transaction_index),
+                        pubkey: expected_key.clone(),
+                        available: false,
+                        unavailable_reason: Some("account_key_mismatch".into()),
+                        lamports: None,
+                        owner: None,
+                        executable: None,
+                        rent_epoch: None,
+                        data: None,
+                    },
+                    Err(error) => AccountSnapshot {
+                        role,
+                        instruction_account_index: None,
+                        transaction_account_index: Some(transaction_index),
+                        pubkey: expected_key.clone(),
+                        available: false,
+                        unavailable_reason: Some(format!("account_borrow:{error:?}")),
+                        lamports: None,
+                        owner: None,
+                        executable: None,
+                        rent_epoch: None,
+                        data: None,
+                    },
+                };
+                selected_accounts_available &= snapshot.available;
+                account_snapshots.push(snapshot);
+            }
+            for instruction_index in 0..instruction.get_number_of_instruction_accounts() {
+                match instruction.get_index_of_instruction_account_in_transaction(instruction_index)
+                {
+                    Ok(transaction_index) => account_snapshots.push(AccountSnapshot {
+                        role: format!("instruction:{instruction_index}"),
+                        instruction_account_index: Some(instruction_index),
+                        transaction_account_index: Some(transaction_index),
+                        pubkey: context
+                            .transaction_context
+                            .get_key_of_account_at_index(transaction_index)
+                            .ok()
+                            .map(|key| key.to_string())
+                            .unwrap_or_default(),
+                        available: false,
+                        unavailable_reason: Some("alias_reference_only".into()),
+                        lamports: None,
+                        owner: None,
+                        executable: None,
+                        rent_epoch: None,
+                        data: None,
+                    }),
+                    Err(error) => account_snapshots.push(AccountSnapshot {
+                        role: format!("instruction:{instruction_index}"),
+                        instruction_account_index: Some(instruction_index),
+                        transaction_account_index: None,
+                        pubkey: String::new(),
+                        available: false,
+                        unavailable_reason: Some(format!("instruction_account_index:{error:?}")),
+                        lamports: None,
+                        owner: None,
+                        executable: None,
+                        rent_epoch: None,
+                        data: None,
+                    }),
+                }
+            }
+            if trace
+                .captured_account_snapshots
+                .saturating_add(account_snapshots.len())
+                > MAX_TRACE_ACCOUNT_SNAPSHOTS
+            {
+                Self::mark_aborted_locked(&mut trace, "account_snapshot_limit");
+                return;
+            }
+            trace.captured_account_snapshots += account_snapshots.len();
+            trace.selected_set_complete &= selected_accounts_available;
+            Self::append_locked(
+                &mut trace,
+                kind,
+                Some(frame_id),
+                parent_frame_id,
+                Some(stack_height),
+                Some(program_id),
+                Some(instruction_data),
+                account_snapshots,
+                outcome,
+            );
+            if !selected_accounts_available {
+                Self::mark_aborted_locked(
+                    &mut trace,
+                    "selected_account_unavailable_or_index_failure",
+                );
+            } else if kind == "push_attempt" && parent_frame_id.is_none() {
+                trace.attempted_top_level_instructions += 1;
+            }
+        }
+
+        pub(super) fn push_attempt(
+            &self,
+            context: &InvokeContext<'_>,
+            frame_id: usize,
+            succeeded: bool,
+            error: Option<&InstructionError>,
+        ) {
+            let parent = match self.active_frames.lock() {
+                Ok(frames) => frames.last().copied(),
+                Err(_) => {
+                    self.abort("observer_frame_lock_poisoned");
+                    return;
+                }
+            };
+            self.record_context(
+                context,
+                "push_attempt",
+                frame_id,
+                parent,
+                Some(match error {
+                    Some(error) => format!("push_error:{error:?}"),
+                    None if succeeded => "push_success".into(),
+                    None => "push_failure".into(),
+                }),
+            );
+            if !succeeded {
+                self.abort("instruction_push_failed");
+                return;
+            }
+            if succeeded {
+                match self.active_frames.lock() {
+                    Ok(mut frames) => frames.push(frame_id),
+                    Err(_) => self.abort("observer_frame_lock_poisoned"),
+                }
+            }
+        }
+
+        pub(super) fn record(
+            &self,
+            context: &InvokeContext<'_>,
+            kind: &'static str,
+            frame_id: usize,
+            outcome: Option<String>,
+        ) {
+            let parent = match self.active_frames.lock() {
+                Ok(frames) => frames.iter().rev().nth(1).copied(),
+                Err(_) => {
+                    self.abort("observer_frame_lock_poisoned");
+                    return;
+                }
+            };
+            self.record_context(context, kind, frame_id, parent, outcome);
+        }
