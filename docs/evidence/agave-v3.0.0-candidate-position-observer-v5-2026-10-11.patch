+        "invoked",
+        invoked_program_id,
+        processor!(invoked_process_instruction),
+    );
+    let context = program_test.start_with_context().await;
+
+    let make_transaction = |data: u8| {
+        let instruction = Instruction::new_with_bytes(
+            invoker_program_id,
+            &[data],
+            vec![AccountMeta::new_readonly(invoked_program_id, false)],
+        );
+        Transaction::new_signed_with_payer(
+            &[instruction],
+            Some(&context.payer.pubkey()),
+            &[&context.payer],
+            context.last_blockhash,
+        )
+    };
+    let (first_result, second_result) = tokio::join!(
+        context
+            .banks_client
+            .process_transaction_with_metadata(make_transaction(1)),
+        context
+            .banks_client
+            .process_transaction_with_metadata(make_transaction(2)),
+    );
