+fn verify_fixture_binding(
+    trace: &Trace,
+    signature: &str,
+    message_hash: &str,
+    run_nonce: &str,
+    attempt_ordinal: u64,
+    message_account_keys: &[Pubkey],
+    banks_result: &BanksTransactionResultWithMetadata,
+) -> Result<(), &'static str> {
+    if trace.transaction_id != signature
+        || trace.message_hash.as_deref() != Some(message_hash)
+        || trace.session_id != run_nonce
+        || trace.attempt_ordinal != Some(attempt_ordinal)
+        || trace.execution_id
+            != format!("{run_nonce}:{signature}:{message_hash}:attempt:{attempt_ordinal}")
+        || trace.selected_accounts
+            != message_account_keys
+                .iter()
+                .map(ToString::to_string)
+                .collect::<Vec<_>>()
+    {
+        return Err("fixture_identity_mismatch");
+    }
+    verify_trace(trace)?;
+    let expected_terminal_outcome = match (&trace.terminal_status, &banks_result.result) {
+        (Some(status), Ok(())) if status == "runtime_success" => "runtime_success".to_owned(),
+        (Some(status), Err(error)) if status == "runtime_failure" => {
+            format!("runtime_error:{error:?}")
+        }
+        _ => return Err("missing_svm_terminal_status"),
+    };
+    if trace
+        .events
+        .last()
+        .and_then(|event| event.outcome.as_deref())
+        != Some(expected_terminal_outcome.as_str())
+    {
+        return Err("banks_client_error_mismatch");
+    }
+    Ok(())
+}
