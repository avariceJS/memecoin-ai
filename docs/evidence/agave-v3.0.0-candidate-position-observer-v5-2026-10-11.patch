+        pub(super) fn pop_outcome(
+            &self,
+            context: &InvokeContext<'_>,
+            frame_id: usize,
+            result: &Result<(), InstructionError>,
+        ) {
+            self.record(
+                context,
+                "pop_outcome",
+                frame_id,
+                Some(match result {
+                    Ok(()) => "pop_success".into(),
+                    Err(error) => format!("pop_error:{error:?}"),
+                }),
+            );
+            if result.is_ok() {
+                match self.active_frames.lock() {
+                    Ok(mut frames) if frames.last() == Some(&frame_id) => {
+                        frames.pop();
+                    }
+                    Ok(_) => self.abort("observer_frame_mismatch"),
+                    Err(_) => self.abort("observer_frame_lock_poisoned"),
+                }
+            } else {
+                self.abort("instruction_pop_failed");
+            }
