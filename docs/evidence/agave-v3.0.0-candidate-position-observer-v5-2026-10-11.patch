+fn invoked_pop_failure(
+    _program_id: &Pubkey,
+    accounts: &[AccountInfo],
+    _input: &[u8],
+) -> ProgramResult {
+    let account = accounts.first().ok_or(ProgramError::NotEnoughAccountKeys)?;
+    let mut lamports = account.try_borrow_mut_lamports()?;
+    **lamports = (**lamports).saturating_add(1);
+    Ok(())
+}
