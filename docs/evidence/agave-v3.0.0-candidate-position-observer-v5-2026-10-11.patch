+    #[derive(Default)]
+    struct FrameValidation {
+        parent: Option<usize>,
+        top_level: bool,
+        stack_height: usize,
+        program_id: Option<String>,
+        instruction_data: Option<Vec<u8>>,
+        pre_seen: bool,
+        execution_result: Option<bool>,
+        post_seen: bool,
+        pop_result: Option<bool>,
+        final_seen: bool,
+    }
+
+    fn validate_attempt_trace(trace: &Trace) -> Result<(), &'static str> {
+        use std::collections::BTreeMap;
+
+        if trace.schema != "agave_candidate_position_transaction_trace_v5"
+            || trace.claim_scope != "runtime_execution_attempt_only"
+            || trace.message_hash.is_none()
+            || !trace.selected_set_complete
+            || trace.attempted_top_level_instructions > trace.expected_instruction_count
+            || trace.not_reached_top_level_instructions
+                != (trace.attempted_top_level_instructions..trace.expected_instruction_count)
+                    .collect::<Vec<_>>()
+        {
+            return Err("trace_identity_or_selected_set_incomplete");
+        }
+        let mut stack = Vec::<usize>::new();
+        let mut frames = BTreeMap::<usize, FrameValidation>::new();
+        let mut expected_frame_id = 0usize;
+        let mut top_level_pushes = 0usize;
+        let mut top_level_finals = 0usize;
+        let mut top_level_frame_order = Vec::<usize>::new();
+
+        for (sequence, event) in trace.events.iter().enumerate() {
+            if event.schema != "agave_candidate_position_event_v5"
+                || event.session_id != trace.session_id
+                || event.execution_id != trace.execution_id
+                || event.transaction_id != trace.transaction_id
+                || event.attempt_ordinal != trace.attempt_ordinal
+                || event.recent_blockhash != trace.recent_blockhash
+                || event.event_sequence != sequence as u64
+            {
+                return Err("event_identity_or_sequence_mismatch");
+            }
+            let frame_id = event.frame_id.ok_or("missing_frame_id")?;
+            match event.kind.as_str() {
+                "push_attempt" => {
+                    if event.parent_frame_id != stack.last().copied()
+                        || frame_id != expected_frame_id
+                        || event.stack_height != stack.len() + 1
+                        || event.program_id.is_none()
+                        || event.instruction_data.is_none()
+                        || frames.contains_key(&frame_id)
+                    {
+                        return Err("push_parent_or_ordinal_mismatch");
+                    }
+                    expected_frame_id += 1;
+                    let top_level = stack.is_empty();
+                    if top_level {
+                        if top_level_frame_order.last().is_some_and(|previous_root| {
+                            !frames
+                                .get(previous_root)
+                                .is_some_and(|previous| previous.final_seen)
+                        }) {
+                            return Err("root_pushed_before_prior_root_final");
+                        }
+                        top_level_pushes += 1;
+                        top_level_frame_order.push(frame_id);
+                    } else if !stack.last().is_some_and(|parent_id| {
+                        frames.get(parent_id).is_some_and(|parent| {
+                            parent.pre_seen && parent.execution_result.is_none()
+                        })
+                    }) {
+                        return Err("child_pushed_outside_parent_execution");
+                    }
+                    match event.outcome.as_deref() {
+                        Some("push_success") => {
+                            validate_account_roles(trace, event)?;
+                            frames.insert(
+                                frame_id,
+                                FrameValidation {
+                                    parent: event.parent_frame_id,
+                                    top_level,
+                                    stack_height: stack.len() + 1,
+                                    program_id: event.program_id.clone(),
+                                    instruction_data: event.instruction_data.clone(),
+                                    ..FrameValidation::default()
+                                },
+                            );
+                            stack.push(frame_id);
+                        }
+                        Some(outcome) if outcome.starts_with("push_error:") => {
+                            return Err("failed_push_cannot_be_complete");
+                        }
+                        _ => return Err("malformed_push_outcome"),
+                    }
+                }
+                "pre_execution" => {
+                    let frame = frames.get_mut(&frame_id).ok_or("pre_without_push")?;
+                    if stack.last().copied() != Some(frame_id)
+                        || frame.parent != event.parent_frame_id
+                        || frame.stack_height != event.stack_height
+                        || frame.program_id != event.program_id
+                        || frame.instruction_data != event.instruction_data
+                        || frame.pre_seen
+                        || event.program_id.is_none()
+                        || event.instruction_data.is_none()
+                    {
+                        return Err("invalid_pre_execution_boundary");
+                    }
+                    validate_account_roles(trace, event)?;
+                    frame.pre_seen = true;
+                }
+                "execution_return" => {
+                    let frame = frames.get_mut(&frame_id).ok_or("return_without_push")?;
+                    if stack.last().copied() != Some(frame_id)
+                        || frame.parent != event.parent_frame_id
+                        || !frame.pre_seen
+                        || frame.stack_height != event.stack_height
+                        || frame.program_id != event.program_id
+                        || frame.instruction_data != event.instruction_data
+                        || frame.execution_result.is_some()
+                    {
+                        return Err("invalid_execution_return_order");
+                    }
+                    validate_account_roles(trace, event)?;
+                    frame.execution_result = Some(match event.outcome.as_deref() {
+                        Some("returned_success") => true,
+                        Some(outcome) if outcome.starts_with("returned_error:") => false,
+                        _ => return Err("malformed_execution_outcome"),
+                    });
+                }
+                "post_execution_pre_pop" => {
+                    let frame = frames.get_mut(&frame_id).ok_or("post_without_push")?;
+                    if stack.last().copied() != Some(frame_id)
+                        || frame.execution_result.is_none()
+                        || frame.stack_height != event.stack_height
+                        || frame.program_id != event.program_id
+                        || frame.instruction_data != event.instruction_data
+                        || frame.post_seen
+                        || frame.parent != event.parent_frame_id
+                    {
+                        return Err("invalid_post_execution_order");
+                    }
+                    validate_account_roles(trace, event)?;
+                    frame.post_seen = true;
+                }
+                "pop_outcome" => {
+                    let frame = frames.get_mut(&frame_id).ok_or("pop_without_push")?;
+                    if stack.last().copied() != Some(frame_id)
+                        || !frame.post_seen
+                        || frame.stack_height != event.stack_height
+                        || frame.program_id != event.program_id
+                        || frame.instruction_data != event.instruction_data
+                        || frame.pop_result.is_some()
+                        || frame.parent != event.parent_frame_id
+                    {
+                        return Err("invalid_pop_order");
+                    }
+                    validate_account_roles(trace, event)?;
+                    match event.outcome.as_deref() {
+                        Some("pop_success") => {
+                            frame.pop_result = Some(true);
+                            stack.pop();
+                        }
+                        Some(outcome) if outcome.starts_with("pop_error:") => {
+                            return Err("failed_pop_cannot_be_complete");
+                        }
+                        _ => return Err("malformed_pop_outcome"),
+                    }
+                }
+                "final_instruction" => {
+                    let frame = frames.get_mut(&frame_id).ok_or("final_without_push")?;
+                    if !frame.top_level
+                        || event.parent_frame_id.is_some()
+                        || frame.final_seen
+                        || !stack.is_empty()
+                        || frame.stack_height != event.stack_height
+                        || frame.program_id != event.program_id
+                        || frame.instruction_data != event.instruction_data
+                        || top_level_frame_order.get(top_level_finals) != Some(&frame_id)
+                        || frame.execution_result.is_none()
+                        || frame.pop_result != Some(true)
+                    {
+                        return Err("invalid_final_instruction_order");
+                    }
+                    validate_account_roles(trace, event)?;
+                    let succeeded = match event.outcome.as_deref() {
+                        Some("instruction_success") => true,
+                        Some(outcome) if outcome.starts_with("instruction_error:") => false,
+                        _ => return Err("malformed_final_instruction_outcome"),
+                    };
+                    if succeeded != frame.execution_result.unwrap_or(false) {
+                        return Err("instruction_return_precedence_mismatch");
+                    }
+                    frame.final_seen = true;
+                    top_level_finals += 1;
+                }
+                "transaction_terminal" | "aborted" => {
+                    if !event.accounts.is_empty() {
+                        return Err("terminal_event_has_accounts");
+                    }
+                    return Err("terminal_event_present_before_seal");
+                }
+                _ => return Err("unknown_event_kind"),
+            }
+        }
+
+        if !stack.is_empty()
+            || top_level_pushes != trace.attempted_top_level_instructions
+            || top_level_finals != top_level_pushes
+            || top_level_finals == 0
+            || top_level_finals > trace.expected_instruction_count
+            || frames.values().any(|frame| {
+                !frame.pre_seen
+                    || frame.execution_result.is_none()
+                    || !frame.post_seen
+                    || frame.pop_result != Some(true)
+                    || (frame.top_level && !frame.final_seen)
+            })
+        {
+            return Err("phase_trace_truncated_or_unbalanced");
+        }
+        Ok(())
+    }
+
+    fn validate_account_roles(trace: &Trace, event: &Boundary) -> Result<(), &'static str> {
+        let selected = event
+            .accounts
+            .iter()
+            .filter(|account| {
+                account.role.starts_with("transaction:")
+                    || account.role.starts_with("transaction_unlisted:")
+            })
+            .collect::<Vec<_>>();
+        if selected.len() != trace.selected_accounts.len() {
+            return Err("selected_account_count_mismatch");
+        }
+        for (index, expected_key) in trace.selected_accounts.iter().enumerate() {
+            let transaction_index = index as u16;
+            let snapshot = selected
+                .iter()
+                .find(|account| account.transaction_account_index == Some(transaction_index))
+                .ok_or("selected_account_missing")?;
+            let expected_role = if event
+                .instruction_account_indices
+                .contains(&transaction_index)
+            {
+                format!("transaction:{index}")
+            } else {
+                format!("transaction_unlisted:{index}")
+            };
+            if snapshot.role != expected_role
+                || snapshot.pubkey != *expected_key
+                || !snapshot.available
+                || snapshot.unavailable_reason.is_some()
+                || snapshot.lamports.is_none()
+                || snapshot.owner.is_none()
+                || snapshot.executable.is_none()
+                || snapshot.rent_epoch.is_none()
+                || snapshot.data.is_none()
+            {
+                return Err("selected_account_unknown_or_mismatched");
+            }
+        }
+        let mut instruction_roles = event
+            .accounts
+            .iter()
+            .filter(|account| account.role.starts_with("instruction:"))
+            .collect::<Vec<_>>();
+        instruction_roles.sort_by_key(|account| account.instruction_account_index);
+        if instruction_roles.len() != event.instruction_account_indices.len() {
+            return Err("instruction_alias_count_mismatch");
+        }
+        for (instruction_index, account) in instruction_roles.iter().enumerate() {
+            let transaction_index = account
+                .transaction_account_index
+                .ok_or("instruction_alias_index_missing")?;
+            if account.instruction_account_index != Some(instruction_index as u16)
+                || event.instruction_account_indices[instruction_index] != transaction_index
+                || transaction_index as usize >= trace.selected_accounts.len()
+                || account.pubkey != trace.selected_accounts[transaction_index as usize]
+                || account.available
+                || account.unavailable_reason.as_deref() != Some("alias_reference_only")
+                || account.lamports.is_some()
+                || account.owner.is_some()
+                || account.executable.is_some()
+                || account.rent_epoch.is_some()
+                || account.data.is_some()
+            {
+                return Err("instruction_alias_mismatch");
+            }
+        }
+        Ok(())
+    }
+}
