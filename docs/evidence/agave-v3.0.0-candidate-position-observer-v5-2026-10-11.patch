+fn verify_account_roles(
+    trace: &Trace,
+    event: &solana_program_runtime::invoke_context::candidate_position_witness::Boundary,
+) -> Result<(), &'static str> {
+    let selected = event
+        .accounts
+        .iter()
+        .filter(|account| {
+            account.role.starts_with("transaction:")
+                || account.role.starts_with("transaction_unlisted:")
+        })
+        .collect::<Vec<_>>();
+    if selected.len() != trace.selected_accounts.len() {
+        return Err("selected_account_count");
+    }
+    for (index, expected) in trace.selected_accounts.iter().enumerate() {
+        let listed = event.instruction_account_indices.contains(&(index as u16));
+        let snapshot = selected
+            .iter()
+            .find(|account| account.transaction_account_index == Some(index as u16))
+            .ok_or("selected_account_missing")?;
+        let expected_role = if listed {
+            format!("transaction:{index}")
+        } else {
+            format!("transaction_unlisted:{index}")
+        };
+        if &snapshot.pubkey != expected || snapshot.role != expected_role {
+            return Err("selected_account_identity");
+        }
+        if !snapshot.available || snapshot.unavailable_reason.is_some() {
+            return Err("selected_account_unknown");
+        }
+        if snapshot.lamports.is_none()
+            || snapshot.owner.is_none()
+            || snapshot.executable.is_none()
+            || snapshot.rent_epoch.is_none()
+            || snapshot.data.is_none()
+        {
+            return Err("available_account_field_missing");
+        }
+        if snapshot.lamports.is_none()
+            || snapshot.owner.is_none()
+            || snapshot.executable.is_none()
+            || snapshot.rent_epoch.is_none()
+            || snapshot.data.is_none()
+        {
+            return Err("available_account_field_missing");
+        }
+    }
+    let instruction_roles = event
+        .accounts
+        .iter()
+        .filter(|account| account.role.starts_with("instruction:"))
+        .collect::<Vec<_>>();
+    if instruction_roles.len() != event.instruction_account_indices.len() {
+        return Err("instruction_role_count_mismatch");
+    }
+    for (instruction_index, account) in instruction_roles.iter().enumerate() {
+        let transaction_index = account
+            .transaction_account_index
+            .ok_or("instruction_index_missing")?;
+        if account.instruction_account_index != Some(instruction_index as u16)
+            || event.instruction_account_indices[instruction_index] != transaction_index
+            || transaction_index as usize >= trace.selected_accounts.len()
+            || account.pubkey != trace.selected_accounts[transaction_index as usize]
+            || account.available
+            || account.unavailable_reason.as_deref() != Some("alias_reference_only")
+            || account.lamports.is_some()
+            || account.owner.is_some()
+            || account.executable.is_some()
+            || account.rent_epoch.is_some()
+            || account.data.is_some()
+        {
+            return Err("instruction_alias_mismatch");
+        }
+    }
+    Ok(())
+}
