+    assert!(
+        banks_result.result.is_ok(),
+        "WSOL fixture failed: {:?}",
+        banks_result.result
+    );
+    let raw_trace = banks_result
+        .metadata
+        .as_ref()
+        .unwrap()
+        .candidate_position_trace
+        .as_ref()
+        .unwrap();
+    let trace: Trace = bincode::deserialize(raw_trace).unwrap();
+    verify_fixture_binding(
+        &trace,
+        &signature,
+        &message_hash,
+        &run_nonce,
+        0,
+        &message_keys,
+        &banks_result,
+    )
+    .unwrap();
+    verify_trace(&trace).unwrap();
+    let phase = |frame_id: usize, kind: &str| {
+        trace
+            .events
+            .iter()
+            .find(|event| event.frame_id == Some(frame_id) && event.kind == kind)
+            .unwrap()
+    };
+    let program_key = token_program.to_string();
+    let wrapped_index = trace
+        .selected_accounts
+        .iter()
+        .position(|key| key == &wrapped_sol.to_string())
+        .unwrap() as u16;
+    let payer_index = trace
+        .selected_accounts
+        .iter()
+        .position(|key| key == &context.payer.pubkey().to_string())
+        .unwrap() as u16;
+    let owner_index = trace
+        .selected_accounts
+        .iter()
+        .position(|key| key == &owner.pubkey().to_string())
+        .unwrap() as u16;
+    for (frame_id, expected_indices, expected_data) in [
+        (0, vec![wrapped_index], vec![17]),
+        (1, vec![wrapped_index, payer_index, owner_index], vec![9]),
+    ] {
+        for kind in [
+            "push_attempt",
+            "pre_execution",
+            "execution_return",
+            "post_execution_pre_pop",
+            "pop_outcome",
+            "final_instruction",
+        ] {
+            let event = phase(frame_id, kind);
+            assert_eq!(event.program_id.as_deref(), Some(program_key.as_str()));
+            assert_eq!(event.instruction_account_indices, expected_indices);
+            assert_eq!(event.instruction_data, Some(expected_data.clone()));
+        }
+    }
+    let before_sync =
+        account_at(&trace, phase(0, "pre_execution"), &wrapped_sol.to_string()).unwrap();
+    let after_sync = account_at(
+        &trace,
+        phase(0, "post_execution_pre_pop"),
+        &wrapped_sol.to_string(),
+    )
+    .unwrap();
+    let before_sync_state =
+        solana_program_test::candidate_position_raw_account::decode_token_account(
+            before_sync.data.as_deref().unwrap(),
+            false,
+        )
+        .unwrap();
+    let after_sync_state =
+        solana_program_test::candidate_position_raw_account::decode_token_account(
+            after_sync.data.as_deref().unwrap(),
+            false,
+        )
+        .unwrap();
+    let native_mint_bytes = native_mint.to_bytes();
+    let owner_bytes = owner.pubkey().to_bytes();
+    for snapshot in [before_sync, after_sync] {
+        assert_eq!(snapshot.owner.as_deref(), Some(program_key.as_str()));
+    }
+    solana_program_test::candidate_position_raw_account::validate_native_account_roles(
+        &before_sync_state,
+        &native_mint_bytes,
+        &owner_bytes,
+        reserve,
+    )
+    .unwrap();
+    solana_program_test::candidate_position_raw_account::validate_native_account_roles(
+        &after_sync_state,
+        &native_mint_bytes,
+        &owner_bytes,
+        reserve,
+    )
+    .unwrap();
+    assert_eq!(before_sync_state.amount, 0);
+    assert_eq!(before_sync_state.native_reserve, Some(reserve));
+    let sync_transition =
+        solana_program_test::candidate_position_raw_account::expected_sync_native_amount(
+            before_sync.lamports.unwrap(),
+            reserve,
+            before_sync_state.amount,
+        )
+        .unwrap();
+    assert_eq!(
+        sync_transition.amount_after_atomic_units,
+        after_sync_state.amount
+    );
+    assert_eq!(after_sync.lamports, before_sync.lamports);
+
+    let before_close =
+        account_at(&trace, phase(1, "pre_execution"), &wrapped_sol.to_string()).unwrap();
+    let after_close = account_at(
+        &trace,
+        phase(1, "post_execution_pre_pop"),
+        &wrapped_sol.to_string(),
+    )
+    .unwrap();
+    let before_close_state =
+        solana_program_test::candidate_position_raw_account::decode_token_account(
+            before_close.data.as_deref().unwrap(),
+            false,
+        )
+        .unwrap();
+    for snapshot in [before_close, after_close] {
+        assert_eq!(snapshot.owner.as_deref(), Some(program_key.as_str()));
+    }
+    solana_program_test::candidate_position_raw_account::validate_native_account_roles(
+        &before_close_state,
+        &native_mint_bytes,
+        &owner_bytes,
+        reserve,
+    )
+    .unwrap();
+    assert_eq!(before_close_state.amount, deposited_lamports);
+    assert_eq!(
+        solana_program_test::candidate_position_raw_account::expected_close_lamports(
+            true,
+            before_close_state.amount,
+            before_close.lamports.unwrap(),
+        ),
+        Ok(reserve + deposited_lamports),
+    );
+    assert_eq!(after_close.lamports, Some(0));
+    assert_eq!(before_close.lamports, Some(reserve + deposited_lamports));
+    let payer_pre = account_at(
+        &trace,
+        phase(1, "pre_execution"),
+        &context.payer.pubkey().to_string(),
+    )
+    .unwrap();
+    let payer_post = account_at(
+        &trace,
+        phase(1, "post_execution_pre_pop"),
+        &context.payer.pubkey().to_string(),
+    )
+    .unwrap();
+    assert_eq!(
+        payer_post.lamports.unwrap() - payer_pre.lamports.unwrap(),
+        reserve + deposited_lamports,
+    );
+
+    let capture = serde_json::json!({
+        "schema":"agave_token_account_raw_witness_v1",
+        "fixture":"program_test_wsol_sync_native_close_account",
+        "claim_scope":"synthetic_attempt_trace_only",
+        "raw_trace_bincode_base64":BASE64.encode(raw_trace),
+        "raw_trace_sha256":solana_program::hash::hash(raw_trace).to_string(),
+        "signed_message_bincode_base64":BASE64.encode(message_bytes),
+        "signed_message_hash":message_hash,
+        "transaction_signature":signature,
+        "run_nonce":run_nonce,
+        "attempt_ordinal":trace.attempt_ordinal,
+        "roles":[
+            {"role":"wsol_account","pubkey":wrapped_sol.to_string(),"message_index":message_keys.iter().position(|key| key == &wrapped_sol).unwrap()},
+            {"role":"native_mint","pubkey":native_mint.to_string(),"source":"wsol_account.data[0..32]"},
+            {"role":"owner","pubkey":owner.pubkey().to_string(),"message_index":message_keys.iter().position(|key| key == &owner.pubkey()).unwrap()},
+            {"role":"close_destination","pubkey":context.payer.pubkey().to_string(),"message_index":message_keys.iter().position(|key| key == &context.payer.pubkey()).unwrap()},
+            {"role":"token_program","pubkey":token_program.to_string(),"message_index":message_keys.iter().position(|key| key == &token_program).unwrap()},
+        ],
+        "fixture_slot":clock.slot,
+        "fixture_epoch":clock.epoch,
+        "rent":{"lamports_per_byte_year":rent.lamports_per_byte_year,"exemption_threshold":rent.exemption_threshold,"burn_percent":rent.burn_percent},
+        "clock_sysvar_bincode_base64":BASE64.encode(bincode::serialize(&clock).unwrap()),
+        "rent_sysvar_bincode_base64":BASE64.encode(bincode::serialize(&rent).unwrap()),
+        "legacy_token_program_elf_sha256":solana_program::hash::hash(include_bytes!("../src/programs/spl_token-3.5.0.so")).to_string(),
+        "agave_source_commit":"b6c96e84b10396b92912d4574dae7d03f606da26",
+        "legacy_token_source_commit":"7c6235d9e7f392129046fabc20ff51e6da1992ab",
+        "rent_source_sha256":"fb51f91e2e93ac41d8776c7d67579b90609a336ea343fdd27060b43305407498",
+        "clock_source_sha256":"ca09b15a28906953ee181f4e06d06dc675bf85dd0904c51045e58d1ae1563a5c",
+        "native_token_source_sha256":"aef2ffcf2fea8e109a946afc95407391f93c82b9b1d533360744c8b55475b161",
+        "svm_terminal_status":trace.terminal_status.clone(),
+        "banks_client_result":format!("{:?}", banks_result.result),
+        "native_transition":{"sync_token_amount_atomic_units":deposited_lamports,"rent_reserve_lamports":reserve,"close_lamports_transferred":reserve + deposited_lamports},
+        "economic_claim":false,
+        "source_completeness_claim":false,
+    });
+    if let Some(path) = std::env::var_os("BRAIN_SENSES_WSOL_RAW_WITNESS_CAPTURE") {
+        write_private_json(path.into(), &capture);
+    }
+}
