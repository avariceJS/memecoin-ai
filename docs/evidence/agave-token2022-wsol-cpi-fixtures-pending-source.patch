+#[tokio::test]
+async fn transaction_observer_raw_token_2022_fee_witness() {
+    let token_program = spl_generic_token::token_2022::ID;
+    let mint = Pubkey::new_unique();
+    let source = Pubkey::new_unique();
+    let destination = Pubkey::new_unique();
+    let owner = Keypair::new();
+    let mut program_test = ProgramTest::default();
+    let run_nonce = enable_witness(&mut program_test, "raw-token-2022-fee");
+    let assumed_rent = Rent::default();
+    let mint_data = raw_token_2022_mint(6, 0);
+    let source_data = raw_token_2022_account(&mint, &owner.pubkey(), 1_000_000);
+    let destination_data = raw_token_2022_account(&mint, &owner.pubkey(), 7);
+    for (key, data) in [
+        (mint, mint_data),
+        (source, source_data),
+        (destination, destination_data),
+    ] {
+        program_test.add_account(
+            key,
+            Account {
+                lamports: assumed_rent.minimum_balance(data.len()).max(1),
+                data,
+                owner: token_program,
+                executable: false,
+                rent_epoch: 0,
+            },
+        );
+    }
+    let context = program_test.start_with_context().await;
+    let clock: Clock = context.banks_client.get_sysvar().await.unwrap();
+    let rent: Rent = context.banks_client.get_sysvar().await.unwrap();
+    let gross = 1_000u64;
+    let mut instruction_data = vec![12]; // TransferChecked discriminator from Token-2022 v8.
+    instruction_data.extend_from_slice(&gross.to_le_bytes());
+    instruction_data.push(6);
+    let instruction = Instruction {
+        program_id: token_program,
+        accounts: vec![
+            AccountMeta::new(source, false),
+            AccountMeta::new_readonly(mint, false),
+            AccountMeta::new(destination, false),
+            AccountMeta::new_readonly(owner.pubkey(), true),
+        ],
+        data: instruction_data,
+    };
+    let transaction = Transaction::new_signed_with_payer(
+        &[instruction],
+        Some(&context.payer.pubkey()),
+        &[&context.payer, &owner],
+        context.last_blockhash,
+    );
+    let signature = transaction.signatures[0].to_string();
+    let message_hash = transaction.message.hash().to_string();
+    let message_keys = transaction.message.account_keys.clone();
+    let message_bytes = bincode::serialize(&transaction.message).unwrap();
+    let banks_result = context
+        .banks_client
+        .process_transaction_with_metadata(transaction)
+        .await
+        .unwrap();
+    assert!(
+        banks_result.result.is_ok(),
+        "Token-2022 fixture transfer must execute: {:?}",
+        banks_result.result
+    );
+    let metadata = banks_result.metadata.as_ref().unwrap();
+    let raw_trace = metadata.candidate_position_trace.as_ref().unwrap();
+    let trace: Trace = bincode::deserialize(raw_trace).unwrap();
+    assert_eq!(trace.transaction_id, signature);
+    verify_fixture_binding(
+        &trace,
+        &signature,
+        &message_hash,
+        &run_nonce,
+        0,
+        &message_keys,
+        &banks_result,
+    )
+    .unwrap();
+    verify_trace(&trace).unwrap();
+    let (fee, net) = verify_fee_transfer_witness(
+        &trace,
+        &source,
+        &mint,
+        &destination,
+        &owner.pubkey(),
+        clock.epoch,
+        gross,
+    )
+    .unwrap();
+    assert_eq!(fee, 25);
+    assert_eq!(net, 975);
+
+    let program_hash =
+        solana_program::hash::hash(include_bytes!("../src/programs/spl_token_2022-8.0.0.so"))
+            .to_string();
+    let fixture_roles = serde_json::json!([
+        {"role":"source","pubkey":source.to_string(),"message_index":message_keys.iter().position(|key| key == &source).unwrap()},
+        {"role":"mint","pubkey":mint.to_string(),"message_index":message_keys.iter().position(|key| key == &mint).unwrap()},
+        {"role":"destination","pubkey":destination.to_string(),"message_index":message_keys.iter().position(|key| key == &destination).unwrap()},
+        {"role":"authority","pubkey":owner.pubkey().to_string(),"message_index":message_keys.iter().position(|key| key == &owner.pubkey()).unwrap()},
+    ]);
+    let raw_capture = serde_json::json!({
+        "schema":"agave_token_2022_raw_account_witness_v1",
+        "fixture":"program_test_token_2022_transfer_fee",
+        "claim_scope":"synthetic_attempt_trace_only",
+        "raw_trace_bincode_base64":BASE64.encode(raw_trace),
+        "raw_trace_sha256":solana_program::hash::hash(raw_trace).to_string(),
+        "signed_message_bincode_base64":BASE64.encode(message_bytes),
+        "signed_message_hash":message_hash,
+        "transaction_signature":signature,
+        "run_nonce":run_nonce,
+        "attempt_ordinal":trace.attempt_ordinal,
+        "roles":fixture_roles,
+        "fixture_slot":clock.slot,
+        "fixture_epoch":clock.epoch,
+        "rent":{"lamports_per_byte_year":rent.lamports_per_byte_year,"exemption_threshold":rent.exemption_threshold,"burn_percent":rent.burn_percent},
+        "clock_sysvar_bincode_base64":BASE64.encode(bincode::serialize(&clock).unwrap()),
+        "rent_sysvar_bincode_base64":BASE64.encode(bincode::serialize(&rent).unwrap()),
+        "token_2022_program_id":token_program.to_string(),
+        "token_2022_program_elf_sha256":program_hash,
+        "source_pins":{
+            "token_2022_commit":"af35bb146ffd4d4f4c43b48bfb0873a041918584",
+            "token_2022_processor_sha256":"38673e2a74e50e43e80e32ef1af277571faa9023eb1b746324b42750c13c4317",
+            "transfer_fee_source_sha256":"c2bcd30c2e3620216ffb65e776143b17818ff3924fd58253bade17e892a12b56",
+            "transfer_hook_source_sha256":"2e462baf487350ef53d66b38fbd2a34da62db41237a940107583bbcf9f7b673b",
+            "transfer_hook_interface_commit":"73c3fff7276117e03462618bddafce8a82a106d2",
+            "rent_source_sha256":"fb51f91e2e93ac41d8776c7d67579b90609a336ea343fdd27060b43305407498",
+            "clock_source_sha256":"ca09b15a28906953ee181f4e06d06dc675bf85dd0904c51045e58d1ae1563a5c",
+            "epoch_schedule_source_sha256":"074198ed79c494c4bf2d49e512b24b77b87a9f2d1b961c3727e608c8fcaeead2",
+            "transfer_hook_status":"unsupported_without_captured_cpi_order_and_effects"
+        },
+        "svm_terminal_status":trace.terminal_status.clone(),
+        "banks_client_result":format!("{:?}", banks_result.result),
+        "parsed":{"gross_atomic_units":gross,"fee_atomic_units":fee,"net_atomic_units":net,"fee_schedule_epoch":clock.epoch},
+        "economic_claim":false,
+        "source_completeness_claim":false,
+    });
+    if let Some(path) = std::env::var_os("BRAIN_SENSES_TOKEN_2022_RAW_WITNESS_CAPTURE") {
+        write_private_json(path.into(), &raw_capture);
+    }
+    let mut missing_state = trace.clone();
+    let post_event = missing_state
+        .events
+        .iter_mut()
+        .find(|event| event.kind == "post_execution_pre_pop")
+        .unwrap();
+    post_event
+        .accounts
+        .retain(|account| account.pubkey != destination.to_string());
+    assert_eq!(
+        verify_fee_transfer_witness(
+            &missing_state,
+            &source,
+            &mint,
+            &destination,
+            &owner.pubkey(),
+            clock.epoch,
+            gross
+        ),
+        Err("destination_after_missing")
+    );
+    let mut reordered = trace.clone();
+    let post_index = reordered
+        .events
+        .iter()
+        .position(|event| event.kind == "post_execution_pre_pop")
+        .unwrap();
+    let return_index = reordered
+        .events
+        .iter()
+        .position(|event| event.kind == "execution_return")
+        .unwrap();
+    reordered.events.swap(post_index, return_index);
+    assert_eq!(
+        verify_fee_transfer_witness(
+            &reordered,
+            &source,
+            &mint,
+            &destination,
+            &owner.pubkey(),
+            clock.epoch,
+            gross
+        ),
+        Err("frame_phase_order")
+    );
+}
