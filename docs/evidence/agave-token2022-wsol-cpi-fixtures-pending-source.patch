+fn append_raw_tlv(account_data: &mut Vec<u8>, extension_type: u16, extension: &[u8]) {
+    account_data.extend_from_slice(&extension_type.to_le_bytes());
+    account_data.extend_from_slice(&(extension.len() as u16).to_le_bytes());
+    account_data.extend_from_slice(extension);
+}
+
+fn raw_token_2022_mint(decimals: u8, current_epoch: u64) -> Vec<u8> {
+    let mut data = vec![0; 166];
+    data[44] = decimals;
+    data[45] = 1; // initialized PodBool
+    data[165] = 1; // AccountType::Mint at Agave-pinned Token-2022 v8 layout
+    let mut fee_config = vec![0; 108]; // 32+32-byte optional authorities + withheld + two schedules
+    for (offset, epoch, max_fee, basis_points) in [
+        (72usize, current_epoch, 100u64, 250u16),
+        (90usize, current_epoch.saturating_add(1), 10u64, 100u16),
+    ] {
+        fee_config[offset..offset + 8].copy_from_slice(&epoch.to_le_bytes());
+        fee_config[offset + 8..offset + 16].copy_from_slice(&max_fee.to_le_bytes());
+        fee_config[offset + 16..offset + 18].copy_from_slice(&basis_points.to_le_bytes());
+    }
+    append_raw_tlv(&mut data, 1, &fee_config); // ExtensionType::TransferFeeConfig
+    data
+}
+
+fn raw_token_2022_account(mint: &Pubkey, owner: &Pubkey, amount: u64) -> Vec<u8> {
+    let mut data = vec![0; 166];
+    data[..32].copy_from_slice(mint.as_ref());
+    data[32..64].copy_from_slice(owner.as_ref());
+    data[64..72].copy_from_slice(&amount.to_le_bytes());
+    data[108] = 1; // AccountState::Initialized
+    data[165] = 2; // AccountType::Account
+    append_raw_tlv(&mut data, 2, &0u64.to_le_bytes()); // TransferFeeAmount
+    data
+}
