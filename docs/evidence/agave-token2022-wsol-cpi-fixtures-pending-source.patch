+fn account_at<'a>(
+    trace: &'a Trace,
+    event: &'a solana_program_runtime::invoke_context::candidate_position_witness::Boundary,
+    key: &str,
+) -> Option<&'a solana_program_runtime::invoke_context::candidate_position_witness::AccountSnapshot>
+{
+    let selected_index = trace
+        .selected_accounts
+        .iter()
+        .position(|account| account == key)?;
+    event.accounts.iter().find(|account| {
+        account.transaction_account_index == Some(selected_index as u16)
+            && account.pubkey == key
+            && account.available
+    })
+}
