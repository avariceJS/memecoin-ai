+fn verify_fee_transfer_witness(
+    trace: &Trace,
+    source: &Pubkey,
+    mint: &Pubkey,
+    destination: &Pubkey,
+    authority: &Pubkey,
+    epoch: u64,
+    gross: u64,
+) -> Result<(u64, u64), &'static str> {
+    use solana_program_test::candidate_position_raw_account::{
+        calculate_fee, decode_mint, decode_token_account, schedule_for_epoch,
+        validate_transfer_roles,
+    };
+    if source == destination || source == mint || destination == mint {
+        return Err("source_mint_destination_alias");
+    }
+    let expected_phases = [
+        "push_attempt",
+        "pre_execution",
+        "execution_return",
+        "post_execution_pre_pop",
+        "pop_outcome",
+        "final_instruction",
+    ];
+    let mut phase_events = Vec::new();
+    let mut phase_positions = Vec::new();
+    for phase in expected_phases {
+        let matches = trace
+            .events
+            .iter()
+            .enumerate()
+            .filter(|(_, event)| event.frame_id == Some(0) && event.kind == phase)
+            .collect::<Vec<_>>();
+        if matches.len() != 1 {
+            return Err("missing_or_duplicate_frame_phase");
+        }
+        phase_positions.push(matches[0].0);
+        phase_events.push(matches[0].1);
+    }
+    if phase_positions.windows(2).any(|pair| pair[0] >= pair[1]) {
+        return Err("frame_phase_order");
+    }
+    if phase_events[2].outcome.as_deref() != Some("returned_success")
+        || phase_events[4].outcome.as_deref() != Some("pop_success")
+    {
+        return Err("failed_attempt_is_not_settlement");
+    }
+    let source_key = source.to_string();
+    let mint_key = mint.to_string();
+    let destination_key = destination.to_string();
+    let authority_key = authority.to_string();
+    let before = phase_events[1];
+    let after = phase_events[3];
+    let token_2022_program = spl_generic_token::token_2022::ID;
+    let expected_program_id = token_2022_program.to_string();
+    let source_index = trace
+        .selected_accounts
+        .iter()
+        .position(|key| key == &source_key)
+        .ok_or("source_selected_account_missing")? as u16;
+    let mint_index = trace
+        .selected_accounts
+        .iter()
+        .position(|key| key == &mint_key)
+        .ok_or("mint_selected_account_missing")? as u16;
+    let destination_index = trace
+        .selected_accounts
+        .iter()
+        .position(|key| key == &destination_key)
+        .ok_or("destination_selected_account_missing")? as u16;
+    let authority_index = trace
+        .selected_accounts
+        .iter()
+        .position(|key| key == &authority_key)
+        .ok_or("authority_selected_account_missing")? as u16;
+    for event in &phase_events {
+        if event.program_id.as_deref() != Some(expected_program_id.as_str())
+            || event.instruction_account_indices.get(0) != Some(&source_index)
+            || event.instruction_account_indices.get(1) != Some(&mint_index)
+            || event.instruction_account_indices.get(2) != Some(&destination_index)
+            || event.instruction_account_indices.get(3) != Some(&authority_index)
+        {
+            return Err("instruction_role_or_program_binding_mismatch");
+        }
+    }
+    let transfer_instruction =
+        solana_program_test::candidate_position_raw_account::decode_supported_instruction(
+            true,
+            before
+                .instruction_data
+                .as_deref()
+                .ok_or("instruction_data_missing")?,
+        )
+        .map_err(|_| "instruction_data_malformed")?;
+    if transfer_instruction != (solana_program_test::candidate_position_raw_account::SupportedInstruction::TransferChecked {
+        gross_atomic_units: gross,
+        decimals: 6,
+    }) {
+        return Err("instruction_amount_or_decimal_mismatch");
+    }
+    let mint_snapshot = account_at(trace, before, &mint_key).ok_or("mint_snapshot_missing")?;
+    if mint_snapshot.owner.as_deref() != Some(expected_program_id.as_str()) {
+        return Err("mint_owner_program_mismatch");
+    }
+    let mint_bytes = mint_snapshot.data.as_deref().ok_or("mint_bytes_missing")?;
+    let parsed_mint = decode_mint(mint_bytes).map_err(|_| "mint_decode_failed")?;
+    if !parsed_mint.initialized {
+        return Err("mint_uninitialized");
+    }
+    let instruction_decimals = match transfer_instruction {
+        solana_program_test::candidate_position_raw_account::SupportedInstruction::TransferChecked {
+            decimals, ..
+        } => decimals,
+        _ => return Err("instruction_data_malformed"),
+    };
+    if parsed_mint.decimals != instruction_decimals {
+        return Err("transfer_checked_decimals_mismatch");
+    }
+    let fee_config = parsed_mint
+        .transfer_fee
+        .as_ref()
+        .ok_or("fee_config_missing")?;
+    let schedule = schedule_for_epoch(fee_config, epoch);
+    let fee = calculate_fee(schedule, gross).map_err(|_| "fee_calculation_failed")?;
+    let source_before_snapshot =
+        account_at(trace, before, &source_key).ok_or("source_before_missing")?;
+    let source_after_snapshot =
+        account_at(trace, after, &source_key).ok_or("source_after_missing")?;
+    let destination_before_snapshot =
+        account_at(trace, before, &destination_key).ok_or("destination_before_missing")?;
+    let destination_after_snapshot =
+        account_at(trace, after, &destination_key).ok_or("destination_after_missing")?;
+    for snapshot in [
+        source_before_snapshot,
+        source_after_snapshot,
+        destination_before_snapshot,
+        destination_after_snapshot,
+    ] {
+        if snapshot.owner.as_deref() != Some(expected_program_id.as_str()) {
+            return Err("token_account_owner_program_mismatch");
+        }
+    }
+    let source_before = decode_token_account(
+        source_before_snapshot
+            .data
+            .as_deref()
+            .ok_or("source_before_missing")?,
+        true,
+    )
+    .map_err(|_| "source_before_decode_failed")?;
+    let source_after = decode_token_account(
+        source_after_snapshot
+            .data
+            .as_deref()
+            .ok_or("source_after_missing")?,
+        true,
+    )
+    .map_err(|_| "source_after_decode_failed")?;
+    let destination_before = decode_token_account(
+        destination_before_snapshot
+            .data
+            .as_deref()
+            .ok_or("destination_before_missing")?,
+        true,
+    )
+    .map_err(|_| "destination_before_decode_failed")?;
+    let destination_after = decode_token_account(
+        destination_after_snapshot
+            .data
+            .as_deref()
+            .ok_or("destination_after_missing")?,
+        true,
+    )
+    .map_err(|_| "destination_after_decode_failed")?;
+    let mint_bytes = mint.to_bytes();
+    let authority_bytes = authority.to_bytes();
+    for (source_account, destination_account) in [
+        (&source_before, &destination_before),
+        (&source_after, &destination_after),
+    ] {
+        validate_transfer_roles(
+            &parsed_mint,
+            source_account,
+            destination_account,
+            &mint_bytes,
+            &authority_bytes,
+            &authority_bytes,
+            instruction_decimals,
+        )
+        .map_err(|_| "token_account_role_mismatch")?;
+    }
+    let source_delta = source_before
+        .amount
+        .checked_sub(source_after.amount)
+        .ok_or("source_amount_increased")?;
+    let destination_delta = destination_after
+        .amount
+        .checked_sub(destination_before.amount)
+        .ok_or("destination_amount_decreased")?;
+    let withheld_delta = destination_after
+        .withheld_amount
+        .ok_or("destination_withheld_missing")?
+        .checked_sub(
+            destination_before
+                .withheld_amount
+                .ok_or("destination_withheld_missing")?,
+        )
+        .ok_or("withheld_amount_decreased")?;
+    if source_delta != gross || destination_delta != gross - fee || withheld_delta != fee {
+        return Err("gross_net_fee_conservation_mismatch");
+    }
+    Ok((fee, destination_delta))
+}
