    base = tmp_path / "research-data"
    base.mkdir(mode=0o700)
    descriptor = os.open(base, os.O_RDONLY | os.O_DIRECTORY)
    failures = {"rename": False}

    def fault_hook(operation: str) -> None:
        if failures["rename"] and operation == "atomic_rename":
            raise OSError("simulated descriptor-bound rename interruption")

