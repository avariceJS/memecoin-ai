def test_plan_chain_replays_and_recovery_returns_exact_persisted_plan() -> None:
    policy = _policy()
    genesis = build_genesis(policy, FIRST_CLOSE)
    first = append_plan(policy, genesis, bucket_close_ns=FIRST_CLOSE)
    persisted = copy.deepcopy(first)
    assert recover_existing_plan(policy, [genesis, first], bucket_close_ns=FIRST_CLOSE) == persisted
    assert verify_chain(policy, [genesis, first])["cursor"] == first["cursor_out"]
    with pytest.raises(ChainError, match="persisted_plan_missing"):
        recover_existing_plan(policy, [genesis], bucket_close_ns=FIRST_CLOSE)


def test_elapsed_bucket_is_explicit_and_does_not_advance_cursor_or_backfill() -> None:
    policy = _policy()
    genesis = build_genesis(policy, FIRST_CLOSE)
    missed = append_missed_bucket_gap(policy, genesis, bucket_close_ns=FIRST_CLOSE)
    next_close = FIRST_CLOSE + scout.BUCKET_NS
    next_plan = append_plan(policy, missed, bucket_close_ns=next_close)
    replay = verify_chain(policy, [genesis, missed, next_plan])
    assert replay["gap_count"] == 1
    assert replay["plan_count"] == 1
    assert missed["cursor"] == genesis["cursor"]
    assert next_plan["cursor_in"] == genesis["cursor"]
    assert next_plan["selection"]["retention"] == []
    assert next_plan["selection"]["bucket_close_ns"] == next_close
    assert next_plan["backfill"] is False


def test_plan_requires_hashed_evidence_from_immediately_prior_bucket() -> None:
    policy = _policy()
    genesis = build_genesis(policy, FIRST_CLOSE)
    prior = _evidence_record(_evidence(ORDERED[0]["pool_id"], FIRST_CLOSE - scout.BUCKET_NS))
    with pytest.raises(ChainError, match="bucket_not_next"):
        append_plan(
            policy,
            genesis,
            bucket_close_ns=FIRST_CLOSE + scout.BUCKET_NS,
            prior_evidence=[prior],
        )
    first = append_plan(policy, genesis, bucket_close_ns=FIRST_CLOSE)
    wrong_bucket = _evidence_record(
        _evidence(ORDERED[0]["pool_id"], FIRST_CLOSE - 2 * scout.BUCKET_NS)
    )
    with pytest.raises(ChainError, match="evidence_not_immediately_prior"):
        append_plan(
            policy,
            first,
            bucket_close_ns=FIRST_CLOSE + scout.BUCKET_NS,
            prior_evidence=[wrong_bucket],
        )
    modified = copy.deepcopy(prior)
    modified["evidence"]["eligible_new_open"] = False
    with pytest.raises(ChainError, match="evidence_hash_invalid"):
        append_plan(
            policy,
            first,
            bucket_close_ns=FIRST_CLOSE + scout.BUCKET_NS,
            prior_evidence=[modified],
        )


def test_replay_rejects_unrecorded_gap_and_semantically_changed_cursor() -> None:
    policy = _policy()
    genesis = build_genesis(policy, FIRST_CLOSE)
    missed = append_missed_bucket_gap(policy, genesis, bucket_close_ns=FIRST_CLOSE)
    second = append_plan(policy, missed, bucket_close_ns=FIRST_CLOSE + scout.BUCKET_NS)
    future = append_plan(policy, genesis, bucket_close_ns=FIRST_CLOSE)
    future["bucket_close_ns"] += scout.BUCKET_NS
    future["next_bucket_close_ns"] += scout.BUCKET_NS
    core = dict(future)
    core.pop("record_sha256")
    future["record_sha256"] = hashlib.sha256(scout.canonical_json(core)).hexdigest()
    with pytest.raises(ChainError, match="bucket_gap_unrecorded"):
        verify_chain(policy, [genesis, future])
    tampered = copy.deepcopy(second)
    tampered["cursor_out"] = (tampered["cursor_out"] + 1) % scout.POOL_COUNT
    core = dict(tampered)
    core.pop("record_sha256")
    tampered["record_sha256"] = hashlib.sha256(scout.canonical_json(core)).hexdigest()
    with pytest.raises(ChainError, match="plan_replay_mismatch"):
        verify_chain(policy, [genesis, missed, tampered])


def test_changed_policy_or_population_fails_closed_before_chain_replay() -> None:
    policy = _policy()
    genesis = build_genesis(policy, FIRST_CLOSE)
    changed = copy.deepcopy(policy)
    changed["population"][0]["base_mint"] = "different"
    with pytest.raises(ChainError, match="policy_hash_invalid"):
        verify_chain(changed, [genesis])


def test_descriptor_journal_persists_once_and_recovery_reuses_identical_plan(
    journal_factory: Any,
) -> None:
    make, _writer, _failures = journal_factory
    journal = make()
    journal.initialize(first_bucket_close_ns=FIRST_CLOSE)
    plan = journal.ensure_plan_for_current_bucket(
        now_ns=FIRST_CLOSE + scout.DISPATCH_EARLIEST_NS,
        bucket_close_ns=FIRST_CLOSE,
    )
    replayed = make().ensure_plan_for_current_bucket(
        now_ns=FIRST_CLOSE + scout.DISPATCH_EARLIEST_NS + 30 * scout.NS,
        bucket_close_ns=FIRST_CLOSE,
        prior_evidence=[
            _evidence_record(_evidence(ORDERED[0]["pool_id"], FIRST_CLOSE - scout.BUCKET_NS))
        ],
    )
    assert replayed == plan
    assert len(journal.records()) == 2
    assert plan["provider_io"] is False


def test_descriptor_journal_records_elapsed_windows_without_plans_or_cursor_motion(
    journal_factory: Any,
) -> None:
    make, _writer, _failures = journal_factory
    journal = make()
    journal.initialize(first_bucket_close_ns=FIRST_CLOSE)
    with pytest.raises(ChainError, match="current_bucket_window_elapsed"):
        journal.ensure_plan_for_current_bucket(
            now_ns=FIRST_CLOSE + scout.BUCKET_NS + scout.REQUEST_START_END_EXCLUSIVE_NS,
            bucket_close_ns=FIRST_CLOSE + scout.BUCKET_NS,
        )
    records = journal.records()
    replay = verify_chain(journal.policy, records)
    assert replay["gap_count"] == 2
    assert replay["plan_count"] == 0
    assert replay["cursor"] == 0


def test_detach_at_atomic_plan_rename_leaves_no_partial_or_fallback_artifact(
    journal_factory: Any,
) -> None:
    make, writer, failures = journal_factory
    journal = make()
    journal.initialize(first_bucket_close_ns=FIRST_CLOSE)
    failures["rename"] = True
    with pytest.raises(OSError, match="simulated descriptor-bound"):
        journal.ensure_plan_for_current_bucket(
            now_ns=FIRST_CLOSE + scout.DISPATCH_EARLIEST_NS,
            bucket_close_ns=FIRST_CLOSE,
        )
    assert writer.list_names(f"{journal.root}/chain") == ("00000000.json",)
    assert writer.list_names(f"{journal.root}") == (
        ".runner.lock",
        "binding.json",
        "chain",
        "policy.json",
    )
    failures["rename"] = False
    plan = journal.ensure_plan_for_current_bucket(
        now_ns=FIRST_CLOSE + scout.DISPATCH_EARLIEST_NS,
        bucket_close_ns=FIRST_CLOSE,
    )
    assert plan["bucket_close_ns"] == FIRST_CLOSE
    assert len(journal.records()) == 2

