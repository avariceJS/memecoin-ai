SOURCE_PIN = hashlib.sha256(b"source-pin").hexdigest()
POPULATION = [
    {
        "pool_id": f"pool-{index:03d}",
        "base_mint": f"mint-{index:03d}",
        "quote_mint": "wsol",
        "rank_sha256": hashlib.sha256(f"{SOURCE_PIN}\0pool-{index:03d}".encode()).hexdigest(),
    }
    for index in range(scout.POOL_COUNT)
]
ORDERED = scout.pool_order(POPULATION, SOURCE_PIN)
FIRST_CLOSE = 1_800_000_000 * scout.NS
FIRST_CLOSE -= FIRST_CLOSE % scout.BUCKET_NS


def _policy() -> dict[str, Any]:
    core = {
        "schema": scout.SCHEMA,
        "schema_version": 1,
        "policy_id": scout.POLICY_ID,
        "source": {"source_pin": SOURCE_PIN},
        "population_count": scout.POOL_COUNT,
        "population_sha256": scout.population_digest(ORDERED),
        "population": ORDERED,
        "provider_io": False,
        "activation_authorized": False,
        "market_source_qualified": False,
        "training_admission": False,
        "economic_admission": False,
    }
    return {**core, "policy_sha256": hashlib.sha256(scout.canonical_json(core)).hexdigest()}


def _evidence(pool_id: str, close: int) -> dict[str, Any]:
    available = close + 225 * scout.NS
    return {
        "pool_id": pool_id,
        "evidence_bucket_close_ns": close,
        "request_started_ns": close + 60 * scout.NS,
        "receipt_ns": available - scout.NS,
        "availability_ns": available,
        "received": True,
        "durable": True,
        "eligible_new_open": True,
    }


def _evidence_record(evidence: dict[str, Any]) -> dict[str, Any]:
    digest = hashlib.sha256(scout.canonical_json(evidence)).hexdigest()
    return {"evidence": evidence, "evidence_sha256": digest}


@pytest.fixture
