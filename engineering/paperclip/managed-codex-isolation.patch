+    let savedClient: any;
+    let nextId = 0;
+    const plugin = definePlugin({
+      async setup(ctx) {
+        ctx.tools.register("scoped", {
+          displayName: "Scoped",
+          description: "Scope probe",
+          parametersSchema: { type: "object", properties: {}, additionalProperties: false },
+        }, async (_params) => {
+          savedClient = ctx.issues.forCurrentToolRun();
+          return await savedClient.get("issue-a", "company-a");
+        });
+        ctx.tools.register("reuse", {
+          displayName: "Reuse",
+          description: "Reuse probe",
+          parametersSchema: { type: "object", properties: {}, additionalProperties: false },
+        }, async () => await savedClient.get("issue-a", "company-a"));
+        ctx.data.register("reuse-saved", async () => await savedClient.get("issue-a", "company-a"));
+      },
+    });
+    const worker = startWorkerRpcHost({ plugin, stdin: hostToWorker, stdout: workerToHost });
+    const invocation = (id: string, agentId: string, runId: string): PluginInvocationContext => ({
+      id,
+      scope: { companyId: "company-a", toolRun: { agentId, runId } },
+    });
+    const callWorker = (method: string, params: unknown, active?: PluginInvocationContext) => {
+      const id = `host-${++nextId}`;
+      const promise = new Promise<JsonRpcResponse>((resolve) => pending.set(id, resolve));
+      hostToWorker.write(serializeMessage({
+        ...createRequest(method, params, id),
+        ...(active ? { paperclipInvocation: active } : {}),
+      }));
+      return promise;
+    };
+    hostReadline.on("line", (line) => {
+      const message = parseMessage(line);
+      if (isJsonRpcResponse(message)) {
+        pending.get(String(message.id))?.(message);
+        pending.delete(String(message.id));
+      } else if (isJsonRpcRequest(message) && message.method === "issues.get") {
+        const call = {
+          id: message.id,
+          invocationId: (message as { paperclipInvocationId?: string }).paperclipInvocationId,
+        };
+        hostCalls.push(call);
+        resolveHostCall?.(call);
+      }
+    });
+    try {
+      await callWorker("initialize", {
+        manifest: {
+          id: "paperclip.run-scoped-test", apiVersion: 1, version: "1.0.0", displayName: "Scoped",
+          description: "Scope test", author: "Tests", categories: ["automation"], capabilities: ["issues.read"],
+          entrypoints: { worker: "dist/worker.js" },
+        }, config: {}, databaseNamespace: null,
+      });
+      const firstCall = new Promise<{ id: string | number; invocationId?: string }>((resolve) => { resolveHostCall = resolve; });
+      const runA = callWorker("executeTool", {
+        toolName: "scoped", parameters: {},
+        runContext: { companyId: "company-a", projectId: "project-a", agentId: "agent-a", runId: "run-a" },
+      }, invocation("invocation-a", "agent-a", "run-a"));
+      const issued = await firstCall;
+      expect(issued.invocationId).toBe("invocation-a");
+
+      const resultB = await callWorker("executeTool", {
+        toolName: "reuse", parameters: {},
+        runContext: { companyId: "company-a", projectId: "project-a", agentId: "agent-b", runId: "run-b" },
+      }, invocation("invocation-b", "agent-b", "run-b"));
+      expect(resultB).toMatchObject({ error: expect.objectContaining({ message: expect.stringContaining("bound to the invocation") }) });
+      expect(hostCalls).toHaveLength(1);
+
+      hostToWorker.write(serializeMessage(createSuccessResponse(issued.id, { id: "issue-a" })));
+      await expect(runA).resolves.toMatchObject({ result: { id: "issue-a" } });
+      const outside = await callWorker("getData", { key: "reuse-saved", companyId: "company-a", params: {} });
+      expect(outside).toMatchObject({ error: expect.objectContaining({ message: expect.stringContaining("bound to the invocation") }) });
+      expect(hostCalls).toHaveLength(1);
+    } finally {
+      worker.stop();
+      hostReadline.close();
+      hostToWorker.destroy();
+      workerToHost.destroy();
+    }
+  });
+});
