diff --git a/server/src/services/native-runtime/native-mcp-assignment.test.ts b/server/src/services/native-runtime/native-mcp-assignment.test.ts
new file mode 100644
index 0000000..56f8361
--- /dev/null
+++ b/server/src/services/native-runtime/native-mcp-assignment.test.ts
@@ -0,0 +1,30 @@
+import { createHash } from "node:crypto";
+import { describe, expect, it } from "vitest";
+import { nativeMcpAssignment, nativeMcpPluginToolNames } from "./native-mcp-assignment.js";
+
+describe("native MCP assignment snapshot", () => {
+  it("intersects exact agent-visible names with registered plugin names and sorts them", () => {
+    expect(nativeMcpPluginToolNames(
+      ["z-plugin:run", "missing-plugin:run", "a-plugin:inspect", "z-plugin:run"],
+      ["a-plugin:inspect", "z-plugin:run", "unassigned-plugin:approve"],
+    )).toEqual(["a-plugin:inspect", "z-plugin:run"]);
+  });
+
+  it("preserves the legacy digest shape when no plugin tools are assigned", () => {
+    const oldShape = { version: 1, agentId: "agent", connections: ["connection"], tools: ["tool"] };
+    const assignment = nativeMcpAssignment({ agentId: "agent", connections: ["connection"], tools: ["tool"] });
+    expect(assignment).toEqual(oldShape);
+    expect(createHash("sha256").update(JSON.stringify(assignment)).digest("hex"))
+      .toBe(createHash("sha256").update(JSON.stringify(oldShape)).digest("hex"));
+  });
+
+  it("pins plugin names in sorted digest material so any assignment drift changes the digest", () => {
+    const first = nativeMcpAssignment({ agentId: "agent", connections: [], tools: [], pluginTools: ["z:run", "a:inspect"] });
+    const reordered = nativeMcpAssignment({ agentId: "agent", connections: [], tools: [], pluginTools: ["a:inspect", "z:run"] });
+    const drifted = nativeMcpAssignment({ agentId: "agent", connections: [], tools: [], pluginTools: ["z:run"] });
+    const digest = (value: unknown) => createHash("sha256").update(JSON.stringify(value)).digest("hex");
+    expect(first.pluginTools).toEqual(["a:inspect", "z:run"]);
+    expect(digest(first)).toBe(digest(reordered));
+    expect(digest(first)).not.toBe(digest(drifted));
+  });
+});
diff --git a/server/src/services/native-runtime/native-mcp-assignment.ts b/server/src/services/native-runtime/native-mcp-assignment.ts
new file mode 100644
index 0000000..10d1a2e
--- /dev/null
+++ b/server/src/services/native-runtime/native-mcp-assignment.ts
@@ -0,0 +1,25 @@
+export function nativeMcpPluginToolNames(
+  agentVisibleNames: readonly string[],
+  registeredPluginNames: readonly string[],
+): string[] {
+  const registered = new Set(registeredPluginNames);
+  return [...new Set(agentVisibleNames)]
+    .filter((name) => registered.has(name))
+    .sort();
+}
+
+export function nativeMcpAssignment(input: {
+  agentId: string;
+  connections: readonly string[];
+  tools: readonly string[];
+  pluginTools?: readonly string[];
+}) {
+  const pluginTools = [...new Set(input.pluginTools ?? [])].sort();
+  return {
+    version: 1,
+    agentId: input.agentId,
+    connections: [...new Set(input.connections)].sort(),
+    tools: [...new Set(input.tools)].sort(),
+    ...(pluginTools.length ? { pluginTools } : {}),
+  };
+}
