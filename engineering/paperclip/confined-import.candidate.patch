+            str(bundle),
+            f"{binding.submitted_sha}:refs/git-gate/import/{binding.submitted_sha}",
+        ),
+        cwd=quarantine,
+    )
+    return NormalizedSubmission(
+        quarantine,
+        binding.submitted_sha,
+        binding.base_sha,
+        bundle_sha,
+        bundle_bytes,
+        export.profile_sha256,
+        imported.profile_sha256,
+        quarantine_config_sha,
+    )
