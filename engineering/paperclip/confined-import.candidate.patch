+        config,
+        exporter,
+        (
+            "-c",
+            "core.hooksPath=/dev/null",
+            "-c",
+            "core.fsmonitor=false",
+            "--no-replace-objects",
+            "-C",
+            str(worker_checkout),
+            "bundle",
