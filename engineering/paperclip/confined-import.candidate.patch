+_LIMITED_GIT_EXEC = """
+import hashlib, os, resource, stat, sys
+from pathlib import Path
+limit, expected, executable, worker_root = sys.argv[1:5]
+limit = int(limit)
+fd = os.open(executable, os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))
+with os.fdopen(fd, 'rb') as stream:
+    if not stat.S_ISREG(os.fstat(stream.fileno()).st_mode):
+        raise SystemExit(80)
+    digest = hashlib.sha256()
+    for block in iter(lambda: stream.read(1024 * 1024), b''):
+        digest.update(block)
+if digest.hexdigest() != expected:
+    raise SystemExit(81)
+if worker_root != '-':
+    gitdir = Path(worker_root) / '.git'
+    if gitdir.is_symlink() or not gitdir.is_dir():
+        raise SystemExit(82)
+    blocked = (
+        gitdir / 'commondir',
+        gitdir / 'objects' / 'info' / 'alternates',
+        gitdir / 'objects' / 'info' / 'http-alternates',
+        gitdir / 'info' / 'grafts',
+        gitdir / 'shallow',
+        gitdir / 'refs' / 'replace',
+    )
+    if any(path.exists() or path.is_symlink() for path in blocked):
+        raise SystemExit(83)
+    objects = gitdir / 'objects'
+    if objects.is_symlink() or not objects.is_dir():
+        raise SystemExit(84)
+    for directory, dirs, files in os.walk(objects, followlinks=False):
+        children = dirs + files
+        if Path(directory).is_symlink() or any(
+            (Path(directory) / name).is_symlink() for name in children
+        ):
+            raise SystemExit(85)
+resource.setrlimit(resource.RLIMIT_FSIZE, (limit, limit))
+os.umask(0o077)
+argv = [executable, *sys.argv[5:]]
+os.execve(executable, argv, os.environ)
+"""
+
+
+def _bounded_file_digest(path: Path, *, limit: int) -> tuple[str, int]:
+    no_follow = getattr(os, "O_NOFOLLOW", None)
+    if no_follow is None:
+        raise BridgeError("git_import_no_follow_unavailable")
+    try:
+        fd = os.open(path, os.O_RDONLY | no_follow | getattr(os, "O_NONBLOCK", 0))
+        with os.fdopen(fd, "rb") as stream:
+            before = os.fstat(stream.fileno())
+            if (
+                not stat.S_ISREG(before.st_mode)
+                or before.st_uid != os.getuid()
+                or before.st_mode & 0o077
+                or before.st_size <= 0
+                or before.st_size > limit
+            ):
+                raise BridgeError("git_import_bundle_file_invalid")
+            digest = hashlib.sha256()
+            total = 0
+            while block := stream.read(1024 * 1024):
+                total += len(block)
+                if total > limit:
+                    raise BridgeError("git_import_bundle_too_large")
+                digest.update(block)
+            after = os.fstat(stream.fileno())
+            if (
+                total != before.st_size
+                or (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns)
+                != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns)
+            ):
+                raise BridgeError("git_import_bundle_changed")
+        return digest.hexdigest(), total
+    except OSError as exc:
+        raise BridgeError("git_import_bundle_unavailable") from exc
+
+
+def _run_confined_git(
+    config: BridgeConfig,
