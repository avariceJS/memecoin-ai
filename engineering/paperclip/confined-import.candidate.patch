+    protected = [
+        config.source_repo,
+        config.publisher_repo,
+        config.broker_journal_dir,
+        config.bridge_journal_dir,
+        config.receipt_store,
+    ]
+    runtime_roots = [
+        *python_runtime_roots(config.python_executable),
+        config.git_executable.parent,
+    ]
+    exporter = SandboxRunner(
+        writable_roots=[export_dir],
+        read_roots=[worker_checkout, *runtime_roots],
+        home=export_dir,
+        protected_roots=protected,
+    )
