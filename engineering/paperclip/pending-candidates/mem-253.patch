index 0000000000000000000000000000000000000000..5690c92461e522e3547e32c10f0bc5663aff1375
--- /dev/null
+++ b/tests/test_research_masked_lag_encoding.py
@@ -0,0 +1,152 @@
+import copy
+import json
+import os
+import subprocess
+import sys
+
+import pytest
+
+from memecoin_experience.masked_lag_encoding import analyze
+
+
+def payload():
+    return {
+        "features": ["x", "y"],
+        "rows": [
+            {"id": "old", "event_ns": 10, "available_ns": 10,
+             "values": {"x": 0, "y": None}},
+            {"id": "late", "event_ns": 15, "available_ns": 35,
+             "values": {"x": 99, "y": 99}},
+            {"id": "tie-z", "event_ns": 20, "available_ns": 22,
+             "values": {"x": 2, "y": 3}},
+            {"id": "tie-a", "event_ns": 20, "available_ns": 22,
+             "values": {"x": 4, "y": 5}},
+        ],
+        "decisions": [{"id": "d", "decision_ns": 30},
+                      {"id": "early", "decision_ns": 2}],
+        "lags_ns": [20, 0, 40],
+        "max_age_ns": 10,
+    }
+
+
+def test_masks_zero_null_availability_ties_age_and_negative_cutoffs():
+    result = analyze(payload())
+    assert result == {
+        "schema": "brain-masked-lag-encoding.v1",
+        "features": ["x", "y"],
+        "lags_ns": [0, 20, 40],
+        "decisions": [
+            {"id": "d", "values": [[4.0, 5.0], [0.0, 0.0], [0.0, 0.0]],
+             "observed": [[True, True], [True, False], [False, False]],
+             "source_ids": [["tie-a", "tie-a"], ["old", "old"], [None, None]]},
+            {"id": "early", "values": [[0.0, 0.0]] * 3,
+             "observed": [[False, False]] * 3,
+             "source_ids": [[None, None]] * 3},
+        ],
+    }
+
+
+def test_empty_collections_and_permutation_invariance_without_mutation():
+    data = {"features": ["x"], "rows": [], "decisions": [],
+            "lags_ns": [2, 0], "max_age_ns": 0}
+    original = copy.deepcopy(data)
+    assert analyze(data) == {"schema": "brain-masked-lag-encoding.v1",
+                             "features": ["x"], "lags_ns": [0, 2], "decisions": []}
+    assert data == original
+    first = analyze(payload())
+    changed_order = payload()
+    changed_order["rows"].reverse()
+    assert analyze(changed_order) == first
+
+
+def test_stale_selection_clears_source_but_fresh_null_keeps_source():
+    data = {
+        "features": ["x"],
+        "rows": [
+            {"id": "stale", "event_ns": 0, "available_ns": 0, "values": {"x": 0}},
+            {"id": "fresh-null", "event_ns": 5, "available_ns": 5, "values": {"x": None}},
+        ],
+        "decisions": [{"id": "d", "decision_ns": 7}],
+        "lags_ns": [0, 4],
+        "max_age_ns": 2,
+    }
+    decision = analyze(data)["decisions"][0]
+    assert decision["values"] == [[0.0], [0.0]]
+    assert decision["observed"] == [[False], [False]]
+    assert decision["source_ids"] == [["fresh-null"], [None]]
+
+
+def test_unbounded_plain_integer_timestamps_remain_valid():
+    timestamp = 10**400
+    data = {
+        "features": ["x"],
+        "rows": [{"id": "r", "event_ns": timestamp, "available_ns": timestamp,
+                  "values": {"x": 1}}],
+        "decisions": [{"id": "d", "decision_ns": timestamp}],
+        "lags_ns": [0],
+        "max_age_ns": 0,
+    }
+    decision = analyze(data)["decisions"][0]
+    assert decision == {"id": "d", "values": [[1.0]], "observed": [[True]],
+                        "source_ids": [["r"]]}
+
+
+@pytest.mark.parametrize("mutate", [
+    lambda p: p.update(extra=1),
+    lambda p: p.update(features=[]),
+    lambda p: p.update(features=["x", "x"]),
+    lambda p: p.update(lags_ns=[0, 0]),
+    lambda p: p.update(lags_ns=[True]),
+    lambda p: p.update(max_age_ns=True),
+    lambda p: p["rows"][0].update(extra=1),
+    lambda p: p["rows"][0].update(event_ns=True),
+    lambda p: p["rows"][0].update(available_ns=9),
+    lambda p: p["rows"][0].update(values={"x": 1}),
+    lambda p: p["rows"][0]["values"].update(x=True),
+    lambda p: p["rows"][0]["values"].update(x=float("inf")),
+    lambda p: p["rows"][0]["values"].update(x=1e12 + 1),
+    lambda p: p["rows"][0]["values"].update(x=10**400),
+    lambda p: p["rows"].append(copy.deepcopy(p["rows"][0])),
+    lambda p: p["decisions"].append(copy.deepcopy(p["decisions"][0])),
+    lambda p: p["decisions"][0].update(decision_ns=-1),
+])
+def test_invalid_api_payloads_raise_value_error(mutate):
+    data = payload()
+    mutate(data)
+    with pytest.raises(ValueError):
+        analyze(data)
+
+
+def _cli(text):
+    env = dict(os.environ, PYTHONPATH="src")
+    return subprocess.run([sys.executable, "-m", "memecoin_experience.masked_lag_encoding"],
+                          input=text, text=True, capture_output=True, env=env, check=False)
+
+
+def test_real_cli_emits_json_result():
+    completed = _cli(json.dumps(payload()))
+    assert completed.returncode == 0
+    assert completed.stderr == ""
+    assert json.loads(completed.stdout) == analyze(payload())
+
+
+@pytest.mark.parametrize("raw", [
+    '{"features":["x"],"features":["y"],"rows":[],"decisions":[],"lags_ns":[0],"max_age_ns":0}',
+    '{"features":["x"],"rows":[],"decisions":[],"lags_ns":[0],"max_age_ns":NaN}',
+    '{"features":["x"],"rows":[],"decisions":[],"lags_ns":[0],"max_age_ns":0} trailing',
+])
+def test_real_cli_rejects_bad_json_without_result(raw):
+    completed = _cli(raw)
+    assert completed.returncode != 0
+    assert completed.stdout == ""
+    assert "invalid input:" in completed.stderr
+
+
+def test_real_cli_normalizes_unbounded_numeric_feature_rejection():
+    data = payload()
+    data["rows"][0]["values"]["x"] = 10**400
+    completed = _cli(json.dumps(data))
+    assert completed.returncode != 0
+    assert completed.stdout == ""
+    assert completed.stderr.startswith("invalid input:")
+    assert "OverflowError" not in completed.stderr
