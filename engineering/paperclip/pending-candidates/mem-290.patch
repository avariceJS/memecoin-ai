+def _compatibility_binding(
+    api: "Paperclip", task_id: str, manifest: dict[str, Any], manifest_hash: str,
+    manifest_path: str | None = None, *, require_process_env: bool = True,
+    check_expiry: bool = True,
+) -> dict[str, Any] | None:
+    """Load a compatibility grant only when the same digest is pinned in native task config."""
+    process_reference = os.environ.get(COMPATIBILITY_ENV)
+    if process_reference is None and require_process_env:
+        return None
+    reference = process_reference
+    if not require_process_env:
+        issue = api.issue(task_id)
+        override = issue.get("assigneeAdapterOverrides")
+        config = override.get("adapterConfig") if type(override) is dict else None
+        env = config.get("env") if type(config) is dict else None
+        reference = env.get(COMPATIBILITY_ENV) if type(env) is dict else None
+    require(type(reference) is str, "compatibility_task_config_binding_missing")
+    require(type(reference) is str and "#" in reference, "compatibility_config_reference_invalid")
+    raw_path, expected_sha = reference.rsplit("#", 1)
+    require(
+        Path(raw_path).is_absolute() and re.fullmatch(r"[0-9a-f]{64}", expected_sha) is not None,
+        "compatibility_config_reference_invalid",
+    )
+    issue = api.issue(task_id)
+    override = issue.get("assigneeAdapterOverrides")
+    config = override.get("adapterConfig") if type(override) is dict else None
+    env = config.get("env") if type(config) is dict else None
+    require(
+        issue.get("id") == task_id
+        and issue.get("companyId") == manifest["company_id"]
+        and issue.get("assigneeAgentId") == manifest["publish"]["agent_id"]
+        and type(env) is dict
+        and env.get(COMPATIBILITY_ENV) == reference,
+        "compatibility_task_config_binding_mismatch",
+    )
+    if require_process_env:
+        require(process_reference == reference, "compatibility_process_config_binding_mismatch")
+    # The frozen process call remains the original module/action/manifest invocation.
+    argv = config.get("args") if type(config) is dict else None
+    require(
+        config.get("cwd") == str(ORG_ROOT)
+        and config.get("command") == str(ORG_ROOT / ".venv/bin/python")
+        and type(argv) is list
+        and argv[:4] == ["-m", "engineering.paperclip_native_delivery", "publish", "--manifest"]
+        and len(argv) == 5
+        and type(argv[4]) is str
+        and Path(argv[4]).is_absolute(),
+        "compatibility_process_invocation_binding_mismatch",
