+        and not stat.S_IMODE(parent.st_mode) & 0o077
+        and stat.S_ISREG(info.st_mode)
+        and info.st_uid == os.getuid()
+        and not stat.S_IMODE(info.st_mode) & 0o077
+        and not stat.S_IMODE(info.st_mode) & 0o222
