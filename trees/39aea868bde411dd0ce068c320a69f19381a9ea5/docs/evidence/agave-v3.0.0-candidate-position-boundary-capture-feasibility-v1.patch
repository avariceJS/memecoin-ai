+#[tokio::test]
+async fn cpi_child_failure_is_attempted_only() {
+    let invoker_program_id = Pubkey::new_unique();
+    let mut program_test = ProgramTest::new(
+        "invoker",
+        invoker_program_id,
+        processor!(invoker_process_instruction),
+    );
+    let invoked_program_id = Pubkey::new_unique();
+    program_test.add_program(
+        "invoked_failure",
+        invoked_program_id,
+        processor!(invoked_failing_process_instruction),
+    );
+
+    let context = program_test.start_with_context().await;
+    let instruction = Instruction::new_with_bincode(
+        invoker_program_id,
+        &[0],
+        vec![AccountMeta::new_readonly(invoked_program_id, false)],
+    );
+    let transaction = Transaction::new_signed_with_payer(
+        &[instruction],
+        Some(&context.payer.pubkey()),
+        &[&context.payer],
+        context.last_blockhash,
+    );
+
+    candidate_position_witness::clear();
+    assert!(context
+        .banks_client
+        .process_transaction(transaction)
+        .await
+        .is_err());
+    let observed = candidate_position_witness::snapshot()
+        .into_iter()
+        .filter(|event| {
+            event.program_id == invoker_program_id.to_string()
+                || event.program_id == invoked_program_id.to_string()
+        })
+        .collect::<Vec<_>>();
+    assert_eq!(observed.len(), 4);
+    assert_eq!(observed[0].phase, "pre_instruction");
+    assert_eq!(observed[1].phase, "pre_instruction");
+    assert_eq!(observed[2].phase, "post_execution_before_pop");
+    assert_eq!(observed[3].phase, "post_execution_before_pop");
+    assert_eq!(
+        observed[1].parent_frame_trace_index,
+        Some(observed[0].frame_trace_index)
+    );
+    assert!(observed[2]
+        .execution_result
+        .as_deref()
+        .unwrap()
+        .starts_with("returned_error:"));
+    assert!(observed[3]
+        .execution_result
+        .as_deref()
+        .unwrap()
+        .starts_with("returned_error:"));
+    let raw = serde_json::to_vec(&observed).unwrap();
+    if let Some(path) = std::env::var_os("BRAIN_SENSES_AGAVE_FAILURE_WITNESS_CAPTURE") {
+        std::fs::write(path, &raw).unwrap();
+    }
 }
 
