 /// Main pipeline from runtime to program execution.
+#[cfg(feature = "dev-context-only-utils")]
+pub mod candidate_position_witness {
+    use {
+        super::InvokeContext,
+        serde::Serialize,
+        solana_account::ReadableAccount,
+        solana_instruction::error::InstructionError,
+        solana_transaction_context::IndexOfAccount,
+        std::{
+            cell::RefCell,
+            sync::{Mutex, OnceLock},
+        },
+    };
+
+    #[derive(Clone, Debug, Serialize)]
+    pub struct AccountSnapshot {
+        pub instruction_account_index: u16,
+        pub transaction_account_index: u16,
+        pub pubkey: String,
+        pub available: bool,
+        pub unavailable_reason: Option<String>,
+        pub lamports: Option<u64>,
+        pub owner: Option<String>,
+        pub executable: Option<bool>,
+        pub rent_epoch: Option<u64>,
+        pub data: Option<Vec<u8>>,
+    }
+
+    #[derive(Clone, Debug, Serialize)]
+    pub struct Boundary {
+        pub schema: &'static str,
+        pub event_sequence: u64,
+        pub phase: &'static str,
+        pub frame_trace_index: usize,
+        pub parent_frame_trace_index: Option<usize>,
+        pub stack_height: usize,
+        pub program_id: String,
+        pub instruction_data: Vec<u8>,
+        pub execution_result: Option<String>,
+        pub accounts: Vec<AccountSnapshot>,
+    }
+
+    static EVENTS: OnceLock<Mutex<Vec<Boundary>>> = OnceLock::new();
+    thread_local! {
+        static FRAME_STACK: RefCell<Vec<usize>> = const { RefCell::new(Vec::new()) };
+    }
+
+    fn events() -> &'static Mutex<Vec<Boundary>> {
+        EVENTS.get_or_init(|| Mutex::new(Vec::new()))
+    }
+
+    pub fn clear() {
+        *events().lock().expect("candidate witness event lock") = Vec::new();
+        FRAME_STACK.with(|stack| stack.borrow_mut().clear());
+    }
+
+    pub fn snapshot() -> Vec<Boundary> {
+        events()
+            .lock()
+            .expect("candidate witness event lock")
+            .clone()
+    }
+
+    fn append(mut boundary: Boundary) {
+        let mut events = events().lock().expect("candidate witness event lock");
+        boundary.event_sequence = events.len() as u64;
+        events.push(boundary);
+    }
+
+    fn make_boundary(
+        context: &InvokeContext<'_>,
+        phase: &'static str,
+        result: Option<String>,
+        frame_override: Option<usize>,
+    ) -> Boundary {
+        let instruction = context
+            .transaction_context
+            .get_current_instruction_context()
+            .expect("process_instruction has pushed an instruction context");
+        let frame_trace_index = frame_override.unwrap_or_else(|| {
+            context
+                .transaction_context
+                .get_instruction_trace_length()
+                .saturating_sub(1)
+        });
+        let stack_height = instruction.get_stack_height();
+        let program_id = instruction
+            .get_program_key()
+            .expect("instruction has a program key")
+            .to_string();
+        let instruction_data = instruction.get_instruction_data().to_vec();
+        let mut accounts = Vec::new();
+        for instruction_account_index in 0..instruction.get_number_of_instruction_accounts() {
+            let account = match instruction
+                .get_index_of_instruction_account_in_transaction(instruction_account_index)
+            {
+                Ok(transaction_account_index) => {
+                    let pubkey = context
+                        .transaction_context
+                        .get_key_of_account_at_index(transaction_account_index)
+                        .map(|key| key.to_string())
+                        .unwrap_or_default();
+                    match context
+                        .transaction_context
+                        .accounts()
+                        .try_borrow(transaction_account_index)
+                    {
+                        Ok(account) => AccountSnapshot {
+                            instruction_account_index,
+                            transaction_account_index,
+                            pubkey,
+                            available: true,
+                            unavailable_reason: None,
+                            lamports: Some(account.lamports()),
+                            owner: Some(account.owner().to_string()),
+                            executable: Some(account.executable()),
+                            rent_epoch: Some(account.rent_epoch()),
+                            data: Some(account.data().to_vec()),
+                        },
+                        Err(error) => AccountSnapshot {
+                            instruction_account_index,
+                            transaction_account_index,
+                            pubkey,
+                            available: false,
+                            unavailable_reason: Some(format!("account_borrow:{error:?}")),
+                            lamports: None,
+                            owner: None,
+                            executable: None,
+                            rent_epoch: None,
+                            data: None,
+                        },
+                    }
+                }
+                Err(error) => AccountSnapshot {
+                    instruction_account_index,
+                    transaction_account_index: IndexOfAccount::MAX,
+                    pubkey: String::new(),
+                    available: false,
+                    unavailable_reason: Some(format!("instruction_account_index:{error:?}")),
+                    lamports: None,
+                    owner: None,
+                    executable: None,
+                    rent_epoch: None,
+                    data: None,
+                },
+            };
+            accounts.push(account);
+        }
+        let parent_frame_trace_index = FRAME_STACK.with(|stack| {
+            let stack = stack.borrow();
+            if phase == "pre_instruction" {
+                stack.last().copied()
+            } else {
+                stack.iter().rev().nth(1).copied()
+            }
+        });
+        Boundary {
+            schema: "agave_candidate_position_boundary_v1",
+            event_sequence: 0,
+            phase,
+            frame_trace_index,
+            parent_frame_trace_index,
+            stack_height,
+            program_id,
+            instruction_data,
+            execution_result: result,
+            accounts,
+        }
+    }
+
+    pub(super) fn record_pre(context: &InvokeContext<'_>) {
+        let boundary = make_boundary(context, "pre_instruction", None, None);
+        FRAME_STACK.with(|stack| stack.borrow_mut().push(boundary.frame_trace_index));
+        append(boundary);
+    }
+
+    pub(super) fn record_post(context: &InvokeContext<'_>, result: &Result<(), InstructionError>) {
+        let active_frame = FRAME_STACK.with(|stack| stack.borrow().last().copied());
+        let boundary = make_boundary(
+            context,
+            "post_execution_before_pop",
+            Some(match result {
+                Ok(()) => "returned_success".to_owned(),
+                Err(error) => format!("returned_error:{error:?}"),
+            }),
+            active_frame,
+        );
+        append(boundary.clone());
+        FRAME_STACK.with(|stack| {
+            let popped = stack.borrow_mut().pop();
+            assert_eq!(popped, Some(boundary.frame_trace_index));
+        });
+    }
+}
